# Copy to .env and fill in real values. .env is gitignored.

# --- Docker Postgres provisioning (consumed by docker-compose.yml) ---
# Local dev DB runs in Docker on host port 5544 (avoids the local 5432).
ROS_DB_MIGRATOR_USER=ros_migrator
ROS_DB_MIGRATOR_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
ROS_DB_APP_USER=ros_app
ROS_DB_APP_PASSWORD=CHANGE_ME_LOCAL_PASSWORD

# --- Prisma / app connections ---
# Migrations & Prisma CLI run as the owner role (ros_migrator).
DATABASE_URL="postgresql://ros_migrator:CHANGE_ME_LOCAL_PASSWORD@localhost:5544/ros?schema=public"
# Runtime app connects as a NON-superuser so FORCE ROW LEVEL SECURITY applies.
APP_DATABASE_URL="postgresql://ros_app:CHANGE_ME_LOCAL_PASSWORD@localhost:5544/ros?schema=public"

# --- Auth secrets. Generate with: openssl rand -base64 64 ---
# In production the value MUST be a real long random secret — placeholder values
# (CHANGE_ME/example/...) are rejected at boot when NODE_ENV=production.
JWT_ACCESS_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Pinned issuer/audience — signed into and required when verifying the access
# JWT. Defaults (ros-identity / ros-identity-api) are fine unless you run
# multiple issuers/audiences.
JWT_ISSUER="ros-identity"
JWT_AUDIENCE="ros-identity-api"

# --- Rate limiting for sensitive auth endpoints (login/refresh/change/forgot/
# reset). Window in ms and max requests per key (IP, or IP+email where present).
# The CODE DEFAULT is production-safe (limit 10 / 60s). This dev value is looser.
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=50

# --- Reverse-proxy trust. Unset/false = trust NO X-Forwarded-* header (a client
# cannot spoof its source IP, which the rate limiter keys on). Behind a trusted
# proxy set the number of proxy hops (e.g. 1), `true`, or a subnet/`loopback`.
# TRUST_PROXY=1

NODE_ENV=development
PORT=3000

# --- SCHED-1 durable scheduled job execution ---
# Whether THIS instance runs the scheduler heartbeat. Disabled unless exactly
# "true". Enabling it on every instance is the intended production setting:
# exactly-once comes from the durable occurrence key and the claim lease, not
# from electing a single instance.
# SCHEDULER_ENABLED=true
# Poll interval, tenants scanned per tick, occurrences claimed per tenant.
SCHEDULER_TICK_MS=30000
SCHEDULER_TENANT_BATCH=100
SCHEDULER_CLAIM_BATCH=10
