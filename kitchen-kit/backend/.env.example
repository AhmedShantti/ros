# Copy to .env and fill in real values. .env is gitignored.

# --- Docker Postgres provisioning (consumed by docker-compose.yml) ---
# Local dev DB runs in Docker on host port 5544 (avoids the local 5432).
ROS_DB_MIGRATOR_USER=ros_migrator
ROS_DB_MIGRATOR_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
ROS_DB_APP_USER=ros_app
ROS_DB_APP_PASSWORD=CHANGE_ME_LOCAL_PASSWORD

# --- Prisma / app connections ---
# Migrations & Prisma CLI run as the owner role (ros_migrator).
DATABASE_URL="postgresql://ros_migrator:CHANGE_ME_LOCAL_PASSWORD@localhost:5544/ros?schema=public"
# Runtime app connects as a NON-superuser so FORCE ROW LEVEL SECURITY applies.
APP_DATABASE_URL="postgresql://ros_app:CHANGE_ME_LOCAL_PASSWORD@localhost:5544/ros?schema=public"

# --- Auth secrets. Generate with: openssl rand -base64 64 ---
JWT_ACCESS_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Rate limiting for sensitive auth endpoints (login/refresh/change/forgot/
# reset). Window in ms and max requests per key (IP, or IP+email where present).
# Defaults are lenient; PRODUCTION SHOULD TIGHTEN (e.g. limit 5-10 per 60s).
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=50

NODE_ENV=development
PORT=3000
