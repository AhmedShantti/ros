# Copy to .env and fill in real values. .env is gitignored.

# PostgreSQL connection (target: plain Postgres, supports RLS + multi-schema).
# The migration/owner role runs prisma migrate; the application role (used at
# runtime) must be a NON-superuser so FORCE ROW LEVEL SECURITY applies to it.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ros?schema=public"

# Access/refresh JWT signing. Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

NODE_ENV=development
PORT=3000
