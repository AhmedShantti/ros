// ROS Identity bounded context — Prisma schema.
// Source of truth: ROS_DrawDB_Compatible_v3.sql (SRS-derived) with two ratified
// overrides recorded in docs/adr/0001-identity-tenancy-and-sessions.md:
//   1. Multi-tenant MEMBERSHIP model (users are tenant-agnostic).
//   2. identity.sessions extended with refresh-token rotation/reuse fields.
// IDs are ULIDs stored as UUID (String @db.Uuid). Money is never modelled here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catalogue", "fiscal", "governance", "identity", "inventory", "kitchen", "org", "production", "sales", "sync", "treasury", "workforce"]
}

// ---------------------------------------------------------------------------
// Phase 2 — Users & Credentials
// Users are tenant-agnostic (membership model, ADR 0001); email is globally
// unique. Passwords/PINs live only in Credential as Argon2id hashes.
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  disabled
  locked

  @@schema("identity")
}

enum CredentialType {
  password
  pin
  oauth

  @@schema("identity")
}

model User {
  id              String     @id @db.Uuid
  email           String     @unique @db.VarChar(255)
  phone           String?    @db.VarChar(24)
  displayName     String     @map("display_name") @db.VarChar(120)
  preferredLocale String     @default("ar") @map("preferred_locale") @db.VarChar(10)
  status          UserStatus @default(active)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentials              Credential[]
  sessions                 Session[]
  memberships              Membership[]
  ownedTenants             Tenant[]                  @relation("TenantOwner")
  passwordResetTokens      PasswordResetToken[]
  countSessionsStarted     CountSession[]            @relation("CountStartedBy")
  countSessionsPosted      CountSession[]            @relation("CountPostedBy")
  wasteRecorded            WasteRecord[]
  movementsPerformed       StockMovement[]
  cashMovementsPerformed   CashMovement[]
  /// P1G-1 back-relation only (virtual; no DDL impact on this model).
  cashClosePoliciesCreated CashClosePolicy[]
  /// P1G-1 migration 34 back-relations only (virtual; no DDL impact).
  closeAttemptsDeclared    CashSessionCloseAttempt[] @relation("CloseAttemptDeclaredByUser")
  cashSessionsClosedBy     CashSession[]             @relation("CashSessionClosedByUser")
  /// Migration 35 back-relations only (virtual; no DDL impact).
  dayCloseActivationsMade  DayCloseActivation[]
  dayClosesClosed          DayClose[]

  // Production Spec back-relations (virtual; no DDL impact).
  publishedRecipeVersions RecipeVersion[] @relation("RecipeVersionPublisher")

  /// D-2 (amended) PIN substrate: an Employee may link to at most one User.
  employee Employee?

  @@map("users")
  @@schema("identity")
}

model Credential {
  id             String         @id @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  credentialType CredentialType @map("credential_type")
  secretHash     String         @map("secret_hash")
  pinForTerminal Boolean        @default(false) @map("pin_for_terminal")
  mustReset      Boolean        @default(false) @map("must_reset")
  rotatedAt      DateTime       @default(now()) @map("rotated_at") @db.Timestamptz(6)
  /// FR-SEC-022 lockout state. Persisted so a lockout survives request and
  /// process boundaries; reset to 0 on a successful verification.
  failedAttempts Int            @default(0) @map("failed_attempts")
  lockedUntil    DateTime?      @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One credential per type per user (one password, one pin, …); rotation
  // updates the row in place rather than inserting duplicates.
  @@unique([userId, credentialType])
  @@map("credentials")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Phase 10 — Password reset tokens
// Opaque single-use tokens for the forgot-password flow; only a SHA-256 hash is
// stored (raw token never persisted). Global identity data (users are
// tenant-agnostic, ADR 0001) → not RLS-scoped, like users/credentials/sessions.
// ---------------------------------------------------------------------------
model PasswordResetToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Phase 3/4 — Sessions
// Extends the approved schema (ADR 0001) with refresh-token rotation/reuse
// fields. The client holds an opaque refresh token; we store only its hash.
// ---------------------------------------------------------------------------
model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  terminalId       String?   @map("terminal_id") @db.Uuid
  membershipId     String?   @map("membership_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  reuseDetectedAt  DateTime? @map("reuse_detected_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")

  // Rotation lineage: the session that superseded this one (1:1).
  replacedBySessionId String?  @unique @map("replaced_by_session_id") @db.Uuid
  replacedBy          Session? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            Session? @relation("SessionRotation")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  terminal   Terminal?   @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([membershipId])
  @@index([terminalId])
  @@map("sessions")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Phase 5 — Tenants & Memberships
// Users are tenant-agnostic (ADR 0001). A Membership is the authorization link
// between a User and a Tenant; only an ACTIVE membership permits tenant
// selection. Roles/permissions attach in Phase 6.
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
  closed

  @@schema("identity")
}

enum MembershipStatus {
  active
  inactive
  suspended

  @@schema("identity")
}

model Tenant {
  id              String       @id @db.Uuid
  slug            String       @unique @db.VarChar(64)
  legalName       String       @map("legal_name") @db.VarChar(255)
  defaultCurrency String       @map("default_currency") @db.Char(3)
  defaultLocale   String       @default("ar") @map("default_locale") @db.VarChar(10)
  // References fiscal.country_packs(code) in the full schema; kept as a plain
  // column here to preserve the Identity bounded-context boundary.
  countryPackCode String       @map("country_pack_code") @db.VarChar(8)
  status          TenantStatus @default(active)
  ownerUserId     String?      @map("owner_user_id") @db.Uuid
  settings        Json         @default("{}") @db.JsonB
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User?        @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  memberships Membership[]
  roles       Role[]
  terminals   Terminal[]

  // Organisation back-relations (ADR 0008 D-09). Prisma requires both sides of a
  // relation to be declared; these add no column and no behaviour to `tenants`.
  brands          Brand[]
  branches        Branch[]
  warehouses      Warehouse[]
  centralKitchens CentralKitchen[]

  // Catalogue back-relations (Phase 16). Prisma requires both sides of a
  // relation; these add no column and no behaviour to `tenants`.
  locations                 Location[]
  stockItems                StockItem[]
  stockItemCategories       StockItemCategory[]
  stockBatches              StockBatch[]
  stockMovements            StockMovement[]
  stockLevels               StockLevel[]
  countSessions             CountSession[]
  wasteRecords              WasteRecord[]
  reasonCodes               ReasonCode[]
  reorderConfigs            StockItemReorderConfig[]
  stockLevelBatchAllocs     StockLevelBatchAllocation[]
  menus                     Menu[]
  menuItems                 MenuItem[]
  taxClasses                TaxClass[]
  shifts                    Shift[]
  drawers                   Drawer[]
  cashSessions              CashSession[]
  cashMovements             CashMovement[]
  /// P1G-1 back-relation only (virtual; no DDL impact on `tenants`).
  cashClosePolicies         CashClosePolicy[]
  /// P1G-1 migration 34 back-relations only (virtual; no DDL impact on `tenants`).
  cashSessionCloseAttempts  CashSessionCloseAttempt[]
  cashCountDenominations    CashCountDenomination[]
  /// Migration 35 back-relations only (virtual; no DDL impact on `tenants`).
  dayCloseActivations       DayCloseActivation[]
  dayCloses                 DayClose[]
  dayCloseTaxClassTotals    DayCloseTaxClassTotal[]
  dayCloseOrderTypeTotals   DayCloseOrderTypeTotal[]
  dayCloseSessions          DayCloseSession[]
  modifierGroups            ModifierGroup[]
  priceLists                PriceList[]
  /// P1E-3 back-relations. Prisma requires both sides of a relation; these add
  /// no column and no behaviour to `tenants`.
  modifiers                 Modifier[]
  stationRoutingRules       StationRoutingRule[]
  branchKdsConfigs          BranchKdsConfig[]
  orderLineStationOverrides OrderLineStationOverride[]
  /// P1E-5 back-relations.
  tickets                   Ticket[]
  ticketFireBatches         TicketFireBatch[]
  ticketLines               TicketLine[]
  ticketLineModifiers       TicketLineModifier[]

  // Production Spec back-relations (virtual; no DDL impact).
  recipes                Recipe[]
  recipeVersions         RecipeVersion[]
  recipeLines            RecipeLine[]
  substituteGroups       SubstituteGroup[]
  substituteGroupMembers SubstituteGroupMember[]
  /// D-2 (amended) PIN substrate.
  employees              Employee[]
  idempotencyKeys        IdempotencyKey[]

  @@map("tenants")
  @@schema("identity")
}

model Membership {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  status    MembershipStatus @default(active)
  /// B1-2 (D-2 REOPENED IN PART (2), clause 7 — T-4-LIVE). Monotonic
  /// authorization/scope epoch. Bumped transactionally whenever this
  /// membership's scoped role-assignment authority changes (create, remove,
  /// re-scope, validity change, inherited-grant review). An access token
  /// carries the epoch it was minted at; a token whose epoch differs from the
  /// live row is a STALE SNAPSHOT and is refused. The token is never the
  /// authorization source — live resolution is — so this detects staleness, it
  /// does not grant.
  authzEpoch Int             @default(0) @map("authz_epoch")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions        Session[]
  membershipRoles MembershipRole[]

  @@unique([userId, tenantId])
  /// B1-2: D-09 composite-FK target, so `membership_roles(tenant_id,
  /// membership_id)` can be made structurally same-tenant.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("memberships")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Phase 6 — RBAC
// Authorization path: Membership -> MembershipRole -> Role -> RolePermission ->
// Permission (ADR 0001). Roles are tenant-scoped (tenant_id NULL = system role,
// is_system = true). Permissions are global, keyed by a stable dot-notation code.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @db.Uuid
  // NULL tenant_id = platform/system role, shared across tenants.
  tenantId    String?  @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(64)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
  @@schema("identity")
}

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(80)
  description String
  module      String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

/// Scope of a role assignment — FR-SEC-002 [M]: "Role assignments SHALL carry a
/// scope, restricting the assignment to a tenant, a brand, a set of branches, or
/// a single branch."
///
/// EXACTLY three members are authorised (D-2 REOPENED IN PART (2), clause 4).
/// `WAREHOUSE`, `CENTRAL_KITCHEN` and `LOCATION` are NOT authorised.
/// `BRANCH_GROUP` is DEFERRED (clause 5) — not rejected: it is a MANDATORY
/// follow-up under FR-BRN-005 once the canonical BranchGroup entity exists, and
/// the enum is additively extensible to it without reinterpreting these three.
///
/// "A set of branches" is represented as MULTIPLE `branch`-scoped rows — never
/// an array, never a polymorphic branch-set object, never a surrogate group.
enum RoleScopeType {
  tenant
  brand
  branch

  @@schema("identity")
}

/// Provenance of a role assignment — M-4+ clause B (D-2 REOPENED IN PART (2),
/// clause 13). Distinguishes authority a human deliberately granted from
/// authority the B1-2 migration inherited from the pre-scope world. Without
/// this the two are indistinguishable forever and no targeted remediation is
/// possible.
enum MembershipRoleOrigin {
  /// Created explicitly through the assignment API with a stated scope.
  explicit
  /// Backfilled by the B1-2 migration as `tenant` scope because that is what
  /// the legacy unscoped assignment actually meant. Until reviewed, the tenant
  /// is NOT multi-branch authorization-ready (M-4+ clauses C and D).
  migration

  @@schema("identity")
}

/// A single scoped role assignment (FR-SEC-002/003/004/005).
///
/// ── IDENTITY ────────────────────────────────────────────────────────────────
/// The shipped `@@id([membershipId, roleId])` is REPLACED by a stable surrogate
/// `id`. ADR 0008 D-02 recorded why: that key admits one row per
/// membership+role, so FR-SEC-003's own worked example ("Branch Manager at
/// Branch 1 and Cashier at Branch 2") was only half-representable and "Cashier
/// at Branch 1 AND Cashier at Branch 2" was not representable at all. Fixing it
/// is a change to the table's identity, not an additive column — authorised by
/// D-2 REOPENED IN PART (2) clause 11.
///
/// ── SCOPE REFERENCES ────────────────────────────────────────────────────────
/// TYPED columns, each with its own tenant-safe composite FK. A single
/// polymorphic `scope_id` is NOT authorised (clause 10): it cannot carry a real
/// FK, and PostgreSQL evaluates referential integrity with row security
/// DISABLED, so RLS alone can never make a cross-tenant scope reference
/// impossible (ADR 0008 D-09). Consistency between `scopeType` and the
/// reference columns is enforced by a database CHECK, not only by TypeScript.
///
/// The legacy `branch_id` column is DROPPED, not left beside `scope_branch_id`
/// (clause 8 of the B1-2 brief): it was never written and never read by any
/// authorization path, and two branch-shaped columns with different authority
/// would be a permanent ambiguity.
model MembershipRole {
  /// Stable per-assignment identity (ULID-as-UUID, `common/ids`).
  id           String   @id @db.Uuid
  /// Local tenant, so scope references can carry tenant-safe composite FKs and
  /// RLS can predicate directly instead of joining `memberships`.
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid

  scopeType RoleScopeType @map("scope_type")
  /// Set iff `scopeType = brand`. Composite FK — can never point at another
  /// tenant's brand.
  scopeBrandId  String? @map("scope_brand_id") @db.Uuid
  /// Set iff `scopeType = branch`. Composite FK — can never point at another
  /// tenant's branch.
  scopeBranchId String? @map("scope_branch_id") @db.Uuid

  /// FR-SEC-005 [S] effective dating. Evaluated LIVE at request time against
  /// the DATABASE clock; expiry needs no sweep job for authority to disappear.
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)

  /// M-4+ provenance and review state.
  origin     MembershipRoleOrigin @default(explicit)
  reviewedAt DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy String?              @map("reviewed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// D-09 composite FK: the assignment can never hang off another tenant's
  /// membership.
  membership  Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  /// Roles may be SYSTEM roles (`tenant_id IS NULL`), so this edge stays a
  /// single-column FK — there is no composite target to point at.
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeBrand  Brand?     @relation(fields: [tenantId, scopeBrandId], references: [tenantId, id], onDelete: Restrict)
  scopeBranch Branch?    @relation(fields: [tenantId, scopeBranchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, membershipId])
  @@index([roleId])
  @@index([tenantId, scopeBranchId])
  @@index([tenantId, scopeBrandId])
  @@map("membership_roles")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Phase 9 — Terminal / device identity (POS security boundary)
// Terminals are tenant-scoped (RLS) and record a branch_id (branch-level authz
// deferred — see docs/adr/0004-terminal-identity.md). Device fingerprints are
// stored ONLY as hashes. Activation/pairing is intentionally deferred (not in
// the approved schema). Sessions bind to a terminal via session.terminal_id.
// ---------------------------------------------------------------------------

enum TerminalStatus {
  active
  disabled
  revoked

  @@schema("identity")
}

enum TerminalType {
  pos
  kds
  kiosk
  handheld

  @@schema("identity")
}

model Terminal {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  // References org.branches(id) in the full schema; the org context is not
  // modelled here, so this is a recorded UUID (no cross-context FK). Branch-level
  // authorization is deferred (ADR 0004).
  branchId     String         @map("branch_id") @db.Uuid
  name         String         @db.VarChar(64)
  terminalType TerminalType   @map("terminal_type")
  status       TerminalStatus @default(active)
  lastSeenAt   DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// D-2 (amended): FR-SEC-021 cannot be trusted while the terminal's branch is
  /// an unenforced UUID. Composite tenant-safe FK per ADR 0008 D-09 — a terminal
  /// can never reference another tenant's branch.
  branch            Branch                    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  fingerprints      DeviceFingerprint[]
  sessions          Session[]
  // Stations that use this terminal as their KDS display (ADR 0008 D-16).
  // Back-relation only — no column, no behaviour change on `terminals`.
  displayStations   Station[]
  // P1D-1: drawers optionally bound to this terminal. Back-relation only.
  drawers           Drawer[]
  // P1F-1: back-relation only — no column, no behaviour change on `terminals`.
  orderPayments     OrderPayment[]
  // P1G-1 migration 34: back-relation only — no column, no behaviour change.
  cashCloseAttempts CashSessionCloseAttempt[]

  // Prevent duplicate terminal registration within a branch (409 on conflict).
  @@unique([tenantId, branchId, name])
  // ADR 0008 D-16: supporting key for the composite FK from org.stations, which
  // makes a station's display terminal structurally same-branch (and therefore
  // same-tenant). Additive index only.
  @@unique([branchId, id])
  @@index([tenantId])
  @@index([branchId])
  @@map("terminals")
  @@schema("identity")
}

model DeviceFingerprint {
  id              String   @id @db.Uuid
  terminalId      String   @map("terminal_id") @db.Uuid
  // SHA-256 hash of the raw device fingerprint — the raw value is never stored.
  fingerprintHash String   @map("fingerprint_hash")
  os              String?  @db.VarChar(32)
  appVersion      String?  @map("app_version") @db.VarChar(32)
  registeredAt    DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)

  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  // Idempotent re-registration of the same device on the same terminal.
  @@unique([terminalId, fingerprintHash])
  @@index([terminalId])
  @@map("device_fingerprints")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Phase 12 — Governance audit trail (append-only, hash-chained, per-tenant)
// governance.audit_entries from the approved SQL. tenant_id is NOT NULL; global/
// anonymous identity-auth events use the reserved sentinel tenant
// 00000000-0000-0000-0000-000000000000 (ADR 0007). No FKs (matches the approved
// DDL) — the sentinel tenant has no tenants row.
// ---------------------------------------------------------------------------
model AuditEntry {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  sequenceNo     BigInt   @map("sequence_no")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  actorId        String?  @map("actor_id") @db.Uuid
  actorType      String   @map("actor_type") @db.VarChar(16)
  impersonatedBy String?  @map("impersonated_by") @db.Uuid
  action         String   @db.VarChar(80)
  entityType     String   @map("entity_type") @db.VarChar(48)
  entityId       String?  @map("entity_id") @db.Uuid
  beforeState    Json?    @map("before_state") @db.JsonB
  afterState     Json?    @map("after_state") @db.JsonB
  reasonCode     String?  @map("reason_code") @db.VarChar(48)
  reasonText     String?  @map("reason_text")
  approverId     String?  @map("approver_id") @db.Uuid
  approvalId     String?  @map("approval_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  terminalId     String?  @map("terminal_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.Uuid
  causationId    String?  @map("causation_id") @db.Uuid
  entryHash      Bytes    @map("entry_hash")
  previousHash   Bytes?   @map("previous_hash")

  @@unique([tenantId, sequenceNo], map: "uq_audit_sequence")
  @@index([tenantId, sequenceNo])
  @@map("audit_entries")
  @@schema("governance")
}

// ---------------------------------------------------------------------------
// Migration 32 — the shared Approval runtime (FR-SEC-030..033). Authority:
// GOVERNANCE_DECISION_REGISTER.md "Approval Runtime Minimum Resolution —
// 2026-08-29" (RATIFIED) + the 2026-08-29 acceptance-closure corrections.
//
// P-1 (RATIFIED): ApprovalDecision references ApprovalRequest DIRECTLY — the
// only intra-Governance relation modelled. No back-relation is added to
// User or Tenant: requestedBy/approverId/excludedApproverUserId are plain
// UUID columns with no FK (identity.users is global, so an FK would give
// zero tenant safety — see the migration's own GRANTS comment).
// ---------------------------------------------------------------------------
model ApprovalRequest {
  id                     String   @id @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  /// Opaque to Governance (D-13). D-16's enumeration remains OPEN — no CHECK.
  requestType            String   @map("request_type") @db.VarChar(32)
  entityType             String   @map("entity_type") @db.VarChar(48)
  entityId               String   @map("entity_id") @db.Uuid
  /// Identity User who requested this approval. No FK (see migration).
  requestedBy            String   @map("requested_by") @db.Uuid
  /// SB-1 RESOLVED (RP-1): an existing SRS §15.2 permission CODE. No FK.
  requiredPermission     String   @map("required_permission") @db.VarChar(64)
  /// SB-2 RESOLVED: opaque carrier. Governance never parses this.
  value                  Json     @db.JsonB
  expiresAt              DateTime @map("expires_at") @db.Timestamptz(6)
  /// Item 8 (F-1 = R-b): an Identity User prohibited from approving this
  /// request. No FK. NULL when no exclusion applies.
  excludedApproverUserId String?  @map("excluded_approver_user_id") @db.Uuid
  /// The ONLY mutable column (D-6 Model B + Mechanism 1).
  status                 String   @default("pending") @db.VarChar(16)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  decision ApprovalDecision?

  @@unique([tenantId, id], map: "approval_requests_tenant_id_id_key")
  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@map("approval_requests")
  @@schema("governance")
}

model ApprovalDecision {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  approvalRequestId String   @map("approval_request_id") @db.Uuid
  /// Identity User who decided. No FK (same posture as audit_entries.approver_id).
  approverId        String   @map("approver_id") @db.Uuid
  decision          String   @db.VarChar(16)
  comment           String?
  /// Bound to statement_timestamp() via DB DEFAULT; ros_app cannot supply
  /// this column (column-level GRANT INSERT in the migration omits it).
  decidedAt         DateTime @default(dbgenerated("statement_timestamp()")) @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request ApprovalRequest @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, approvalRequestId], map: "uq_approval_decision_per_request")
  @@index([tenantId, approverId])
  @@map("approval_decisions")
  @@schema("governance")
}

// ---------------------------------------------------------------------------
// Phase 15 — Organisation bounded context (ADR 0008, Accepted 2026-08-15).
//
// Tenant ownership (D-08): brands, branches, warehouses and central kitchens are
// TENANT-owned (direct tenant_id → direct RLS anchor). Stations, tables,
// operating hours, print routing and station routing rules carry NO tenant_id —
// exactly as the approved SQL defines them — and inherit the tenant boundary
// through their parent branch (ADR 0003 child-inheritance precedent).
//
// Composite tenant-safe FKs (D-09): PostgreSQL evaluates referential-integrity
// checks with row security DISABLED, so a plain FK cannot stop a row pointing at
// another tenant's parent. Every edge where the child carries its own tenant_id,
// or references a SIBLING the branch-anchored RLS predicate does not validate,
// uses a composite FK backed by a `@@unique([<parent key>, id])` target.
// ---------------------------------------------------------------------------

/// Branch availability flag (D-03). Deliberately NOT a state machine: the SRS
/// defines no branch lifecycle, so there are no transitions, guards or effects.
enum BranchStatus {
  active
  inactive

  @@schema("org")
}

/// Warehouse classification (D-17). Values are taken verbatim from the approved
/// SQL's comment. No CHECK correlates this with `branch_id` — the sources define
/// no such rule.
enum WarehouseType {
  branch
  central
  virtual

  @@schema("org")
}

/// Brand — aggregate root (SRS §7.3 #4). Belongs to exactly one tenant.
model Brand {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(120)
  theme           Json     @default("{}") @db.JsonB
  defaultSettings Json     @default("{}") @map("default_settings") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  branches Branch[]

  // B1-2 scoped RBAC back-relation (virtual; no DDL impact on this model).
  roleAssignments MembershipRole[]

  // D-09 composite-FK target.

  // Production Spec back-relations (virtual; no DDL impact).
  recipes Recipe[]

  @@unique([tenantId, id])
  // D-15 natural key. Tenant-prefixed, so a 409 can never disclose another
  // tenant's brand names.
  @@unique([tenantId, name])
  @@map("brands")
  @@schema("org")
}

/// Branch — aggregate root (SRS §7.3 #5); contains OperatingHours, Tables and
/// PrintRouting. Belongs to one brand, one timezone, one base currency.
model Branch {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  brandId  String @map("brand_id") @db.Uuid
  /// Immutable after creation: FR-POS-002 embeds `<branch_code>` in offline-
  /// generated order numbers, so changing it would make historical human-readable
  /// identifiers ambiguous. Enforced in BranchesService (not accepted on update).
  code     String @db.VarChar(16)
  name     String @db.VarChar(120)
  /// IANA zone (e.g. Africa/Cairo).
  timezone String @db.VarChar(48)

  baseCurrency          String       @map("base_currency") @db.Char(3)
  countryCode           String       @map("country_code") @db.Char(2)
  address               Json?        @db.JsonB
  status                BranchStatus @default(active)
  /// FR-MNU-031 flag carried by the approved branch table. Stored only — the
  /// auto-86 behaviour belongs to Catalogue + Inventory.
  automaticAvailability Boolean      @default(true) @map("automatic_availability")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  /// D-09: composite FK — a branch can never point at another tenant's brand.
  brand  Brand  @relation(fields: [tenantId, brandId], references: [tenantId, id])

  warehouses        Warehouse[]
  stations          Station[]
  menuBranches      MenuBranch[]
  availabilityRules AvailabilityRule[]
  locations         Location[]
  tables            BranchTable[]
  operatingHours    OperatingHours[]
  printRouting      PrintRouting[]
  routingRules      StationRoutingRule[]
  /// FR-KDS-010 tier 5 (P1E-3) — at most one config row per branch.
  kdsConfig         BranchKdsConfig?

  // Production Spec back-relations (virtual; no DDL impact).
  recipes Recipe[]

  // B1-2 scoped RBAC back-relation (virtual; no DDL impact on this model).
  roleAssignments   MembershipRole[]

  // D-2 (amended) PIN substrate back-relations.
  terminals         Terminal[]
  homeEmployees     Employee[]       @relation("EmployeeHomeBranch")
  permittedForStaff EmployeeBranch[]

  // P1D-1 Workforce / Treasury back-relations (virtual; no DDL impact).
  shifts            Shift[]
  drawers           Drawer[]
  cashSessions      CashSession[]
  // P1G-0 back-relation only (virtual; no DDL impact on this model).
  cashMovements     CashMovement[]
  // P1G-1 back-relation only (virtual; no DDL impact on this model).
  cashClosePolicies CashClosePolicy[]
  // Migration 35 back-relations only (virtual; no DDL impact on this model).
  dayCloseActivations DayCloseActivation[]
  dayCloses           DayClose[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], map: "uq_branch_code")
  @@index([tenantId, brandId])
  @@map("branches")
  @@schema("org")
}

/// Warehouse — aggregate root (SRS §7.3 #6). TENANT-owned (D-08), optionally
/// attached to one branch.
model Warehouse {
  id            String        @id @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  name          String        @db.VarChar(120)
  warehouseType WarehouseType @default(branch) @map("warehouse_type")
  /// NULL = standalone warehouse.
  branchId      String?       @map("branch_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id])

  centralKitchens CentralKitchen[]
  locations       Location[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, branchId])
  @@map("warehouses")
  @@schema("org")
}

/// Central Kitchen — TENANT-owned (D-08), bound to exactly one warehouse.
/// SRS §7.3 defines no Central Kitchen aggregate; treated as a root because the
/// approved SQL gives it its own tenant-scoped table.
model CentralKitchen {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  name        String @db.VarChar(120)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  warehouse Warehouse  @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  locations Location[]

  /// P15-1: supporting key for the org.locations composite FK. Branches and
  /// warehouses already carried (tenant_id, id); central kitchens did not.
  /// Additive index only — no column, no behaviour change.
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  /// D-15: one central kitchen per warehouse (the approved SQL's NOT NULL
  /// warehouse_id implies 1:1 but does not enforce it).
  @@unique([warehouseId])
  @@map("central_kitchens")
  @@schema("org")
}

/// Station — Organisation aggregate root (D-07), owning StationRoutingRules.
/// Tenant scope is inherited through the branch; no tenant_id column.
model Station {
  id                String   @id @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  name              String   @db.VarChar(64)
  capacityConfig    Json     @default("{}") @map("capacity_config") @db.JsonB
  /// FR-KDS-001 [M]. P1E-3 addition — same VARCHAR(9) nullable convention as
  /// `catalogue.categories.colour` / `catalogue.menu_items.colour`.
  displayColour     String?  @map("display_colour") @db.VarChar(9)
  displayTerminalId String?  @map("display_terminal_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// D-16: composite FK — the display terminal must belong to the same branch,
  /// and therefore to the same tenant.
  displayTerminal Terminal? @relation(fields: [branchId, displayTerminalId], references: [branchId, id])

  printRouting         PrintRouting[]
  routingRules         StationRoutingRule[]
  kdsConfigFallbackOf  BranchKdsConfig[]
  lineStationOverrides OrderLineStationOverride[]
  tickets              Ticket[]

  // D-09 composite-FK target for print routing and station routing rules.
  @@unique([branchId, id])
  @@unique([branchId, name])
  @@map("stations")
  @@schema("org")
}

/// Branch table — physical/service location under a branch. `status` is
/// deliberately ABSENT (D-05): live table state is order-driven, high-churn and
/// owned by Sales.
model BranchTable {
  id           String  @id @db.Uuid
  branchId     String  @map("branch_id") @db.Uuid
  label        String  @db.VarChar(16)
  section      String? @db.VarChar(64)
  seatCapacity Int?    @map("seat_capacity") @db.SmallInt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, id])
  @@unique([branchId, label], map: "uq_table_label")
  @@map("tables")
  @@schema("org")
}

/// Operating hours — one row per interval. Multiple rows per weekday model split
/// shifts; overlapping intervals are rejected in the service layer (D-04). A
/// `closes_at` earlier than `opens_at` denotes an overnight interval (SRS
/// glossary, "Business Day"). `day_of_week` is 0 = Sunday … 6 = Saturday (D-04).
model OperatingHours {
  id                 String   @id @db.Uuid
  branchId           String   @map("branch_id") @db.Uuid
  dayOfWeek          Int      @map("day_of_week") @db.SmallInt
  opensAt            DateTime @map("opens_at") @db.Time(6)
  closesAt           DateTime @map("closes_at") @db.Time(6)
  businessDayCutover DateTime @default(dbgenerated("'00:00:00'::time without time zone")) @map("business_day_cutover") @db.Time(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, dayOfWeek])
  @@map("operating_hours")
  @@schema("org")
}

/// Print routing — configuration only. No priority and no active flag: neither
/// the SRS nor the approved SQL defines them.
model PrintRouting {
  id            String  @id @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  documentType  String  @map("document_type") @db.VarChar(24)
  printerTarget String  @map("printer_target") @db.VarChar(64)
  /// NULL = branch-level default (no specific station).
  stationId     String? @map("station_id") @db.Uuid

  branch  Branch   @relation(fields: [branchId], references: [id])
  /// D-09: composite FK — a rule can only target a station in its own branch.
  station Station? @relation(fields: [branchId, stationId], references: [branchId, id])

  // D-15. Prisma emits a plain UNIQUE here, under which PostgreSQL treats NULLs
  // as distinct — so branch-level defaults (station_id IS NULL) would not be
  // de-duplicated. The migration REPLACES this index with
  // `UNIQUE NULLS NOT DISTINCT`, which Prisma cannot express. See
  // migration.sql and docs/organisation/rls.md.
  @@unique([branchId, documentType, stationId])
  @@map("print_routing")
  @@schema("org")
}

/// Station routing rule — Organisation-side configuration only. Resolution
/// (FR-KDS-010) belongs to Kitchen Ops. `menu_item_id` / `category_id` carry no
/// FK because Catalogue does not exist yet, exactly as the approved SQL defines.
/// Lives in the `kitchen` schema per SRS §25.1 (D-06).
/// FR-KDS-010 routing configuration. P1E-3 hardening (P1E-2 §J):
/// - `tenant_id` added — ADR 0008 D-06's stated reason for FK-less selectors
///   ("Catalogue does not exist") has expired now that Catalogue exists.
/// - `modifier_id` added (tier 2).
/// - Exactly-one-selector is enforced by a DB CHECK constraint (hand-written
///   in the migration; Prisma cannot express CHECK constraints — see
///   `PrintRouting`'s equivalent NULLS NOT DISTINCT precedent).
/// - Duplicate `(branch, selector, station)` rows are prevented by a
///   `UNIQUE ... NULLS NOT DISTINCT` index (ADR 0008 D-15 left this
///   "deliberately open" pending Catalogue keys that now exist).
/// `priority` is retained physically with NO assigned semantics (P1E-2 §D,
/// KDS-R9) — the resolver (`modules/kitchen`) MUST NOT read it.
model StationRoutingRule {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  stationId  String  @map("station_id") @db.Uuid
  menuItemId String? @map("menu_item_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  modifierId String? @map("modifier_id") @db.Uuid
  priority   Int     @default(0) @db.SmallInt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  /// D-09 composite FK — a rule can only target a branch within its own tenant.
  branch   Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id])
  /// D-09: composite FK — a rule can only target a station in its own branch.
  station  Station   @relation(fields: [branchId, stationId], references: [branchId, id])
  /// D-09 composite FKs — a rule can never select another tenant's catalogue
  /// entity. Exactly one of these three is non-null (DB CHECK).
  menuItem MenuItem? @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Cascade)
  category Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  modifier Modifier? @relation(fields: [tenantId, modifierId], references: [tenantId, id], onDelete: Cascade)

  @@unique([branchId, menuItemId, categoryId, modifierId, stationId], map: "uq_station_routing_rule_selector_station")
  @@index([branchId, stationId])
  @@index([tenantId, branchId, menuItemId])
  @@index([tenantId, branchId, categoryId])
  @@index([tenantId, branchId, modifierId])
  @@map("station_routing_rules")
  @@schema("kitchen")
}

/// FR-KDS-010 tier 5 (branch fallback station). P1E-3 addition — one row per
/// branch. Physical schema `kitchen` (co-located with `station_routing_rules`,
/// the table it is a configuration sibling of); LOGICAL ownership is
/// Organisation (ADR 0008 D-07/D-06: station configuration is Organisation;
/// FR-KDS-010 resolution BEHAVIOUR is Kitchen Ops). `org.settings` was
/// considered and rejected — ADR 0008 D-11 (DEFERRED) records it "cannot be
/// RLS-anchored as designed" because it has no `tenant_id`.
model BranchKdsConfig {
  branchId                       String  @id @map("branch_id") @db.Uuid
  tenantId                       String  @map("tenant_id") @db.Uuid
  fallbackStationId              String? @map("fallback_station_id") @db.Uuid
  /// FR-KDS-025 [M] — "retained for a configurable period (default 30
  /// minutes)". The SRS gives the default explicitly, so this one may be
  /// source-supported. P1E-5.
  recallWindowSeconds            Int     @default(1800) @map("recall_window_seconds")
  /// FR-KDS-029 [M] requires a configurable cancelled-line visibility period
  /// but names NO default — unlike FR-KDS-025. Nullable, no `@default`: no
  /// source text authorizes a guessed number (900s, 1800s, or otherwise).
  /// NULL = not yet configured; a future cancellation-handler slice supplies
  /// a value, not this one. P1E-5.
  cancelledLineVisibilitySeconds Int?    @map("cancelled_line_visibility_seconds")

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  /// D-09 composite FK — config can only exist for a branch in its own tenant.
  branch          Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  /// D-09 composite FK — the fallback MUST belong to this same branch.
  fallbackStation Station? @relation(fields: [branchId, fallbackStationId], references: [branchId, id])

  @@unique([tenantId, branchId])
  @@map("branch_kds_config")
  @@schema("kitchen")
}

// ---------------------------------------------------------------------------
// P1E-5 — Kitchen Ops: Ticket/TicketLine persistence (SRS §7.3 #23, §25.1).
// Design closed by docs/reports/claude/2026-08-22_P1E4_ticket-ticketline-
// design-closure.md, corrected by the P1E-5 prompt's four acceptance
// corrections (modifier-kind backfill safety; Sales modifier snapshot
// idempotency via `orderLineModifierId`; fire-batch sequence-free identity;
// Kitchen-owned order-type snapshot scalar — see each model's own docblock).
//
// Logical ownership: Kitchen Ops (unlike `station_routing_rules`/
// `branch_kds_config`, which are Organisation-owned configuration stored in
// this same physical schema per ADR 0008 D-06/D-07). Ticket is Kitchen's own
// aggregate (§7.3 #23: "Derived from Order; independent lifecycle").
// ---------------------------------------------------------------------------

/// Kitchen-owned lifecycle state. FR-KDS-040 timestamps are the source of
/// truth for "when"; this enum answers "what state", which two states
/// (`recalled`, and a ticket whose lines are not all terminal) cannot be
/// derived from timestamps alone. No `cancelled` Ticket state — FR-KDS-029
/// cancels LINES, not tickets (P1E-4 §N).
enum TicketStatus {
  queued
  in_progress
  ready
  bumped
  served
  recalled

  @@schema("kitchen")
}

/// Kitchen-owned lifecycle state for one TicketLine. No `recalled` line
/// state — FR-KDS-025 recalls TICKETS ("restoring the most recently bumped
/// tickets"); a recalled ticket's lines return to `queued`/`started` (P1E-4
/// §N/§P).
enum TicketLineStatus {
  queued
  started
  ready
  bumped
  served
  cancelled

  @@schema("kitchen")
}

/// Kitchen's OWN copy of the three FR-POS-021 kinds — deliberately NOT
/// `catalogue.ModifierKind`. P1E-5 acceptance correction: a Kitchen snapshot
/// crossing the `order.line.fired` domain-event boundary must not create a
/// hard PostgreSQL type dependency from `kitchen` onto `catalogue` (the same
/// principle the correction applies to `tickets.order_type_snapshot` not
/// reusing `sales."OrderType"` — see that field's docblock). The event
/// CONTRACT (TypeScript union, `kitchen/contract`) is the semantic boundary;
/// this enum is the Kitchen-local storage of what the contract already
/// guarantees is one of exactly three values, never null (the handler
/// receives `kind` as a required, non-nullable field on the event payload —
/// see `order.line.fired`'s payload type).
enum ModifierKindSnapshot {
  addition
  removal
  substitution

  @@schema("kitchen")
}

/// FR-KDS-020 card + FR-KDS-040 timestamps. ONE row per (tenant, order,
/// station) — the Glossary's "routed to one preparation station", made
/// stable across amendments by FR-KDS-028 ("never as a new ticket"). A line
/// routed to N stations produces N `TicketLine` rows, one under each
/// station's own Ticket — no `ticket_stations` join table (P1E-4 §D).
///
/// Self-contained by design (P1E-4 §F): every field a KDS card needs is
/// snapshotted here or on `TicketLine`/`TicketLineModifier`. Kitchen
/// application code never reads `sales.*` or `catalogue.*` to render or
/// operate a ticket — the composite FKs below exist for referential
/// integrity only (checked by PostgreSQL with RLS disabled, ADR 0008 D-09),
/// never for a live read path.
model Ticket {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// ENGINEERING-REQUIRED (not itself an FR-KDS-020 field): `org.stations`
  /// carries no `tenant_id`, so a tenant-safe Station FK needs `branch_id` to
  /// compose `(branch_id, station_id)`; the Order FK below additionally
  /// proves this `branch_id` IS the order's own branch, closing the "Station
  /// outside the order's branch" gap structurally (P1E-4 §J).
  branchId    String   @map("branch_id") @db.Uuid
  businessDay DateTime @map("business_day") @db.Date
  orderId     String   @map("order_id") @db.Uuid
  stationId   String   @map("station_id") @db.Uuid

  orderNumberSnapshot      String  @map("order_number_snapshot") @db.VarChar(24)
  /// P1E-5 acceptance correction (was `sales."OrderType"` in the P1E-4
  /// design): a Kitchen-owned scalar, not a foreign PostgreSQL enum type —
  /// this snapshot crosses the `order.line.fired` domain-event boundary and
  /// must not create a hard Kitchen -> Sales database-type dependency.
  /// Validated against the v1 event contract's union at the application
  /// layer (`kitchen/contract`), not by a DB CHECK — the same trust boundary
  /// as every other event payload field.
  orderTypeSnapshot        String  @map("order_type_snapshot") @db.VarChar(32)
  /// FR-KDS-020 "table or customer reference" — a pre-redacted DISPLAY
  /// STRING supplied by the Fire producer, never customer PII (P1E-4 §F).
  serviceReferenceSnapshot String? @map("service_reference_snapshot") @db.VarChar(64)

  status  TicketStatus @default(queued)
  /// §24.6.4 optimistic concurrency — Ticket is an aggregate root whose state
  /// projection is updated by concurrent bump/recall operations.
  version Int          @default(1)

  /// FR-KDS-040 "created" — the handler's own instant, explicit (no
  /// `DEFAULT now()`; P1E-4 §N / §22).
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  /// FR-KDS-040 "routed" — `event.payload.firedAt`, the Fire command's own
  /// instant. Set ONCE, at Ticket creation; an amendment's later fire time
  /// lives on its own `TicketFireBatch.firedAt`, never overwrites this.
  routedAt      DateTime  @map("routed_at") @db.Timestamptz(6)
  firstViewedAt DateTime? @map("first_viewed_at") @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  readyAt       DateTime? @map("ready_at") @db.Timestamptz(6)
  bumpedAt      DateTime? @map("bumped_at") @db.Timestamptz(6)
  servedAt      DateTime? @map("served_at") @db.Timestamptz(6)

  /// FR-KDS-022/023. Nullable — population is deferred (FR-KDS-044 `[S]`);
  /// the column exists so a later slice is a value change, not a schema one.
  targetReadyAt DateTime? @map("target_ready_at") @db.Timestamptz(6)

  /// FR-KDS-025. `bumpedAt` is preserved (never cleared) through a recall —
  /// FR-KDS-042 needs it; `recallCount > 0` flags a ticket time that is not a
  /// clean measurement (P1E-4 §P).
  recalledAt  DateTime? @map("recalled_at") @db.Timestamptz(6)
  recallCount Int       @default(0) @map("recall_count") @db.SmallInt

  /// FR-KDS-041 "by employee" — otherwise impossible to attribute (P1E-4 §R).
  startedBy String? @map("started_by") @db.Uuid
  bumpedBy  String? @map("bumped_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  /// D-09 composite FK, partition-safe: proves `branchId` is genuinely this
  /// order's own branch, targeting the P1E-3 K-1 additive unique — no new
  /// Sales index required by this slice.
  order   Order   @relation(fields: [tenantId, orderId, businessDay, branchId], references: [tenantId, id, businessDay, branchId], onDelete: Restrict)
  /// D-09 composite FK — the Station must be in this same branch (chained
  /// with the Order FK above, a Station outside the order's branch is
  /// unrepresentable).
  station Station @relation(fields: [branchId, stationId], references: [branchId, id], onDelete: Restrict)

  fireBatches TicketFireBatch[]
  lines       TicketLine[]

  /// D-09 target for `TicketLine`'s composite Ticket FK (proves a line's
  /// `orderId`/`businessDay` match its own Ticket's).
  @@unique([tenantId, id])
  /// CARDINALITY INVARIANT (P1E-4 §D) — one Ticket per order+station.
  @@unique([tenantId, orderId, businessDay, stationId], map: "uq_tickets_order_station")
  /// Additive FK target for `TicketLine` — proves same-order membership.
  @@unique([tenantId, id, orderId, businessDay], map: "uq_tickets_id_order_business_day")
  @@index([tenantId, branchId, stationId, status, routedAt])
  @@index([tenantId, orderId, businessDay])
  @@index([tenantId, branchId, stationId, targetReadyAt])
  @@map("tickets")
  @@schema("kitchen")
}

/// FR-POS-038 / FR-KDS-028 amendment identity. P1E-5 acceptance correction
/// (REMOVES the P1E-4 design's `sequenceNo` allocator): the SRS requires
/// amendments to be DISTINGUISHABLE, not contiguously numbered, and a
/// per-ticket `MAX(sequence)+1` allocator is a concurrency race with no
/// database-authoritative guard. `fireBatchId` (Sales-minted, one per Fire
/// command) is the idempotency key instead — `UNIQUE (tenant_id, ticket_id,
/// fire_batch_id)` makes a replayed Fire a no-op with NO retry loop. Display
/// ordering is `ORDER BY firedAt, id` (id is a ULID, so ties break in
/// creation order) — the earliest batch is the original fire; every later
/// one is an amendment. No persisted amendment number.
model TicketFireBatch {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  /// The Sales Fire COMMAND's own identity — shared by every line event the
  /// same Fire command publishes, across every station Ticket it touches.
  fireBatchId String   @map("fire_batch_id") @db.Uuid
  /// FR-KDS-042 "fire time" — `event.payload.firedAt`, explicit (no
  /// `DEFAULT now()`).
  firedAt     DateTime @map("fired_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  lines TicketLine[]

  @@unique([tenantId, id])
  /// IDEMPOTENCY — one Fire command touches a given ticket at most once.
  @@unique([tenantId, ticketId, fireBatchId], map: "uq_ticket_fire_batches_ticket_fire_batch")
  /// FK target for `TicketLine` — proves a batch belongs to the line's own ticket.
  @@unique([tenantId, ticketId, id], map: "uq_ticket_fire_batches_ticket_id")
  @@index([tenantId, ticketId, firedAt])
  @@map("ticket_fire_batches")
  @@schema("kitchen")
}

/// FR-KDS-020/040. `sequence`/`course` mirror `sales.order_lines`' own
/// fields, captured at fire time (BR-POS-004 principle extended to the
/// Kitchen boundary). Deliberately NO `stationId`/`branchId` — both are the
/// owning Ticket's (P1E-4 §K); FR-KDS-011's multi-station case is expressed
/// by two `TicketLine` rows under two `Ticket`s, not by a column here.
model TicketLine {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  fireBatchRowId String   @map("fire_batch_row_id") @db.Uuid
  /// Carried solely so the two composite FKs below can both be checked
  /// against it, proving "this line's order = this ticket's order" is
  /// unrepresentable otherwise (P1E-4 §K/§M) — not read directly by
  /// application code.
  orderId        String   @map("order_id") @db.Uuid
  orderLineId    String   @map("order_line_id") @db.Uuid
  businessDay    DateTime @map("business_day") @db.Date

  itemNameSnapshot Json    @map("item_name_snapshot") @db.JsonB
  quantity         Decimal @db.Decimal(12, 3)
  course           Int?    @db.SmallInt
  sequence         Int     @db.SmallInt
  preparationNotes String? @map("preparation_notes")

  status TicketLineStatus @default(queued)

  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  routedAt      DateTime  @map("routed_at") @db.Timestamptz(6)
  firstViewedAt DateTime? @map("first_viewed_at") @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  readyAt       DateTime? @map("ready_at") @db.Timestamptz(6)
  bumpedAt      DateTime? @map("bumped_at") @db.Timestamptz(6)
  servedAt      DateTime? @map("served_at") @db.Timestamptz(6)

  /// FR-KDS-029 — marked, never deleted.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// Set only by a ticket-level recall (no line-level recall state; P1E-4 §N).
  recalledAt  DateTime? @map("recalled_at") @db.Timestamptz(6)

  startedBy String? @map("started_by") @db.Uuid
  bumpedBy  String? @map("bumped_by") @db.Uuid

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  /// D-09 composite FK, chained through `orderId`/`businessDay`: proves this
  /// line's order matches its OWN ticket's order (P1E-4 §K's integrity proof).
  ticket    Ticket          @relation(fields: [tenantId, ticketId, orderId, businessDay], references: [tenantId, id, orderId, businessDay], onDelete: Cascade)
  /// D-09 composite FK, partition-safe: proves the OrderLine belongs to the
  /// SAME order named above — targets the P1E-3 K-1 additive unique, no new
  /// Sales index required.
  orderLine OrderLine       @relation(fields: [tenantId, orderId, orderLineId, businessDay], references: [tenantId, orderId, id, businessDay], onDelete: Restrict)
  /// D-09 composite FK — the batch must belong to THIS line's own ticket.
  fireBatch TicketFireBatch @relation(fields: [tenantId, ticketId, fireBatchRowId], references: [tenantId, ticketId, id], onDelete: Cascade)

  modifiers TicketLineModifier[]

  @@unique([tenantId, id])
  /// IDEMPOTENCY + "one line per ticket" — a replayed Fire cannot duplicate
  /// this row; the SAME OrderLine MAY appear on a different Ticket
  /// (different `ticketId`), which is exactly FR-KDS-011's multi-station case.
  @@unique([tenantId, ticketId, orderLineId], map: "uq_ticket_lines_ticket_order_line")
  @@index([tenantId, ticketId, status])
  @@index([tenantId, ticketId, fireBatchRowId])
  @@index([tenantId, orderLineId, businessDay])
  @@map("ticket_lines")
  @@schema("kitchen")
}

/// FR-KDS-020 "modifiers" / FR-KDS-021 (addition vs removal rendered
/// differently). Relational, not JSON — an enum `kind` makes an invalid
/// value unrepresentable, which FR-KDS-021 `[M]`'s enforceability needs
/// (P1E-4 §G). P1E-5 acceptance correction: idempotency keys on the SOURCE
/// SALES ROW (`sourceOrderLineModifierId`), not on `sourceModifierId` alone —
/// FR-MNU-011's `allowRepeat`/free-quantity threshold make a repeated
/// selection of the SAME Catalogue modifier legal, so `modifierId` cannot be
/// the uniqueness key.
model TicketLineModifier {
  id                        String @id @db.Uuid
  tenantId                  String @map("tenant_id") @db.Uuid
  ticketLineId              String @map("ticket_line_id") @db.Uuid
  /// The stable identity of the CAPTURED Sales selection
  /// (`sales.order_line_modifiers.id`) — the idempotency key. `modifierId`
  /// alone cannot serve this role (see model docblock).
  sourceOrderLineModifierId String @map("source_order_line_modifier_id") @db.Uuid
  /// Traceability only — never read by Kitchen application code as a live
  /// lookup path.
  sourceModifierId          String @map("source_modifier_id") @db.Uuid

  nameSnapshot Json                 @map("name_snapshot") @db.JsonB
  kind         ModifierKindSnapshot
  quantity     Int                  @default(1) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                  Tenant            @relation(fields: [tenantId], references: [id])
  ticketLine              TicketLine        @relation(fields: [tenantId, ticketLineId], references: [tenantId, id], onDelete: Cascade)
  /// D-09 composite FK — traceability/integrity only, never a live read path.
  sourceModifier          Modifier          @relation(fields: [tenantId, sourceModifierId], references: [tenantId, id], onDelete: Restrict)
  /// D-09 composite FK to the Sales-owned capture row — integrity only.
  sourceOrderLineModifier OrderLineModifier @relation(fields: [tenantId, sourceOrderLineModifierId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  /// IDEMPOTENCY: replaying the same Sales modifier snapshot is a no-op. Two
  /// DISTINCT Sales rows selecting the same Catalogue modifier (legal under
  /// `allowRepeat`) remain independently representable.
  @@unique([tenantId, ticketLineId, sourceOrderLineModifierId], map: "uq_ticket_line_modifiers_line_source")
  @@index([tenantId, ticketLineId])
  @@map("ticket_line_modifiers")
  @@schema("kitchen")
}

// ---------------------------------------------------------------------------
// Phase 16 — Catalogue bounded context ("what can be sold", SRS §5.3).
// Ratified design gate: docs/catalogue/PHASE_16_DISCOVERY.md + the C-01…C-11
// ratification. Plan: docs/catalogue/PHASE_16_PLAN.md.
//
// Ubiquitous language (SRS §5.3): "Item" here means SELLABLE. In Inventory it
// means STOCKABLE. No Inventory, Production Spec, Fiscal, Sales or Combo entity
// is created by this phase.
//
// Tenancy: tables that reference a SIBLING or cross-aggregate entity carry
// tenant_id so a composite tenant-safe FK (D-09) can be expressed; pure children
// inherit through their parent via EXISTS (ADR 0003). No tenant_id was added
// "merely because it feels safer".
// ---------------------------------------------------------------------------

/// C-06: branch_group is deliberately absent — ADR 0008 D-10 deferred branch
/// groups, so FR-MNU-020's fourth scope is not implementable and is not claimed.
enum PriceListScope {
  tenant
  brand
  branch

  @@schema("catalogue")
}

/// Menu (FR-MNU-001/002/003). Applicability = branch assignment + order_types
/// + active_window + priority + is_active. No implicit tenant-global resolution.
model Menu {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Localised: {"ar": "...", "en": "..."}
  name         Json     @db.JsonB
  /// FR-MNU-002. Vocabulary is owned by Sales (sales.order_type_enum) but stored
  /// as text here by the approved design — no Sales dependency is created.
  orderTypes   String[] @default([]) @map("order_types")
  /// FR-MNU-002 time windows; opaque per the approved SQL.
  activeWindow Json?    @map("active_window") @db.JsonB
  /// FR-MNU-003 explicit priority ordering.
  priority     Int      @default(0) @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  branches   MenuBranch[]
  categories Category[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("menus")
  @@schema("catalogue")
}

/// C-01: explicit menu↔branch assignment. FR-MNU-002 [M] requires menus to be
/// assignable to branches; the approved SQL modelled order types and time
/// windows but had no branch axis at all.
model MenuBranch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  menuId    String   @map("menu_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  menu   Menu   @relation(fields: [tenantId, menuId], references: [tenantId, id])
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, menuId, branchId])
  @@index([tenantId, branchId])
  @@map("menu_branches")
  @@schema("catalogue")
}

/// Category / sub-category (FR-MNU-001). Menu-scoped; self-referencing parent
/// gives the optional sub-category level. No lifecycle column (C-09).
model Category {
  id               String  @id @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  menuId           String  @map("menu_id") @db.Uuid
  parentCategoryId String? @map("parent_category_id") @db.Uuid
  name             Json    @db.JsonB
  /// FR-MNU-007 category-level sort order.
  sortOrder        Int     @default(0) @map("sort_order") @db.SmallInt
  colour           String? @db.VarChar(9)

  menu     Menu       @relation(fields: [tenantId, menuId], references: [tenantId, id])
  parent   Category?  @relation("CategoryTree", fields: [tenantId, parentCategoryId], references: [tenantId, id])
  children Category[] @relation("CategoryTree")

  placements          MenuItemPlacement[]
  /// FR-KDS-010 tier 4 (P1E-3). Prisma requires both sides of a relation.
  stationRoutingRules StationRoutingRule[]

  @@unique([tenantId, id])
  @@index([tenantId, menuId])
  @@map("categories")
  @@schema("catalogue")
}

/// MenuItem — the canonical sellable identity (C-02). TENANT-scoped and reusable
/// across menus: it deliberately has NO category_id, because an item that
/// appears on both the Main and Delivery menus must remain ONE identity (the
/// shared ItemId kernel with Production Spec, SRS §5.3.1). Placement on menus is
/// the separate `MenuItemPlacement` relation.
model MenuItem {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  /// FR-MNU-005 surfaces. `names` = customer-facing/POS. The RECEIPT surface has
  /// no column in the approved SQL — documented gap, not invented here.
  names              Json     @db.JsonB
  kitchenNames       Json     @default("{}") @map("kitchen_names") @db.JsonB
  aggregatorNames    Json     @default("{}") @map("aggregator_names") @db.JsonB
  description        Json?    @db.JsonB
  /// C-04 AMENDMENT (2026-08-20): still NULLABLE - onboarding master data
  /// legitimately arrives incomplete - but no longer FK-less. Every non-null
  /// value is a real tenant-safe reference to `fiscal.tax_classes`, enforced by
  /// the DATABASE. An item with NULL here is NOT SELLABLE: line capture fails
  /// rather than defaulting to `standard`, because a defaulted tax class is a
  /// wrong tax return.
  taxClassId         String?  @map("tax_class_id") @db.Uuid
  revenueAccountCode String?  @map("revenue_account_code") @db.VarChar(32)
  barcodePlu         String?  @map("barcode_plu") @db.VarChar(32)
  allergens          String[] @default([])
  dietaryTags        String[] @default([]) @map("dietary_tags")
  /// FR-MNU-007 item-level sort order.
  sortOrder          Int      @default(0) @map("sort_order") @db.SmallInt
  colour             String?  @db.VarChar(9)
  /// FR-MNU-004 behavioural flags. `isCombo` is retained because FR-MNU-004 [M]
  /// requires it, but NO combo tables exist — Combo is deferred (C-08).
  isCombo            Boolean  @default(false) @map("is_combo")
  isOpenPrice        Boolean  @default(false) @map("is_open_price")
  isWeighed          Boolean  @default(false) @map("is_weighed")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// D-09 composite FK: a MenuItem can never point at another tenant's TaxClass.
  taxClass TaxClass? @relation(fields: [tenantId, taxClassId], references: [tenantId, id])

  variants            MenuItemVariant[]
  images              MenuItemImage[]
  placements          MenuItemPlacement[]
  modifierGroupLinks  ModifierGroupLink[]
  /// FR-KDS-010 tier 3 (P1E-3, C-03) — MenuItem-level, not Variant-level.
  stationRoutingRules StationRoutingRule[]
  availabilityRules   AvailabilityRule[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("menu_items")
  @@schema("catalogue")
}

/// C-02: placement of a tenant-scoped MenuItem into a menu-scoped Category.
/// One item may be placed in many categories/menus without duplicating identity.
/// Carries no sort order — FR-MNU-007's two axes are already served by
/// `menu_items.sort_order` (item level) and `categories.sort_order` (category
/// level), so none is invented here.
model MenuItemPlacement {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  menuItem MenuItem @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Cascade)
  category Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, menuItemId, categoryId])
  @@index([tenantId, categoryId])
  @@map("menu_item_placements")
  @@schema("catalogue")
}

/// Variant (FR-MNU-006): independent pricing, barcode and availability.
/// C-03: `station_id` is deliberately ABSENT. FR-KDS-010 assigns a station "for
/// this branch", but a variant is tenant-scoped and org.stations is
/// branch-scoped, so a single tenant-wide station_id cannot express it — and the
/// variant carries no branch discriminator to build a tenant-safe composite FK
/// against. Station routing stays with Organisation/Kitchen Ops.
/// ---------------------------------------------------------------------------
/// fiscal.tax_classes - the stable semantic TaxClass identity (C-04 AMENDMENT,
/// 2026-08-20; see docs/catalogue/README.md).
///
/// WHAT THIS TABLE IS. A tenant's answer to "which semantic tax class is this
/// item assigned to?" - nothing more. `sales.order_lines.tax_class_id` snapshots
/// this UUID at sale time (BR-POS-004), and it stays meaningful forever because
/// it never carries a rate.
///
/// WHAT THIS TABLE IS NOT. It holds NO rate, NO component definition, NO
/// rounding rule and NO order-type override. All of those are data inside the
/// pinned CountryPack VERSION (CR-03, ADR-005). That separation is the whole
/// design: a pack may change what `standard` charges without rewriting one
/// historical order line, because the line stores the identity and the order
/// stores the pack version.
///
/// The approved SQL shape (`id, tenant_id, name, country_pack_code`) is extended
/// by exactly one column - the immutable semantic `code` - because `name` is a
/// localisable display label and cannot serve as a lookup key into a pack class
/// list.
model TaxClass {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// The jurisdiction family this class belongs to; matches
  /// `identity.tenants.country_pack_code` / `org.branches.country_code`.
  /// Deliberately FK-less: `fiscal.country_packs` is not created - a pack is a
  /// signed BUNDLE artefact, and the approved SQL registry row has no payload.
  countryPackCode String   @map("country_pack_code") @db.VarChar(8)
  /// IMMUTABLE semantic key, matched against the pinned pack `tax.classes[].code`.
  /// The set is OPEN: a pack may define a code this repository has never seen.
  code            String   @db.VarChar(32)
  /// Localised display label. Free to change; never used for lookup.
  names           Json     @db.JsonB
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  menuItems MenuItem[]

  /// Tenant-leading composite target, so catalogue.menu_items can hold a
  /// tenant-safe FK (ADR 0008 D-09) rather than a bare id an RLS-bypassing FK
  /// check could satisfy from another tenant.
  @@unique([tenantId, id])
  @@unique([tenantId, countryPackCode, code], map: "uq_tax_class_code")
  @@index([tenantId, countryPackCode])
  @@map("tax_classes")
  @@schema("fiscal")
}

model MenuItemVariant {
  id              String  @id @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  menuItemId      String  @map("menu_item_id") @db.Uuid
  name            Json    @db.JsonB
  barcode         String? @db.VarChar(32)
  prepTimeSeconds Int?    @map("prep_time_seconds")
  sortOrder       Int     @default(0) @map("sort_order") @db.SmallInt
  isActive        Boolean @default(true) @map("is_active")

  menuItem MenuItem @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Cascade)

  priceEntries      PriceEntry[]
  availabilityRules AvailabilityRule[]

  // Production Spec back-relations (virtual; no DDL impact).
  recipes Recipe[]

  @@unique([tenantId, id])
  @@index([tenantId, menuItemId])
  @@map("menu_item_variants")
  @@schema("catalogue")
}

/// Pure child of MenuItem — inherits the tenant boundary via EXISTS (ADR 0003).
model MenuItemImage {
  id         String @id @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid
  url        String
  sortOrder  Int    @default(0) @map("sort_order") @db.SmallInt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_images")
  @@schema("catalogue")
}

/// Availability configuration + manual 86 (FR-MNU-030/031/032).
/// C-07: `quantity_sold_today` and `daily_quantity_limit` are ABSENT — daily
/// limits decrementing on sale (FR-MNU-035 [C]) are Sales runtime state and are
/// deferred. A rule targets EXACTLY ONE of menu_item / variant (XOR CHECK in the
/// migration).
model AvailabilityRule {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  menuItemId     String?   @map("menu_item_id") @db.Uuid
  variantId      String?   @map("variant_id") @db.Uuid
  /// FR-MNU-030 "per item, per branch". NULL = applies to all branches.
  branchId       String?   @map("branch_id") @db.Uuid
  channel        String?   @db.VarChar(16)
  dayOfWeek      Int?      @map("day_of_week") @db.SmallInt
  startsAt       DateTime? @map("starts_at") @db.Time(6)
  endsAt         DateTime? @map("ends_at") @db.Time(6)
  isManual86     Boolean   @default(false) @map("is_manual_86")
  autoReenableAt DateTime? @map("auto_reenable_at") @db.Timestamptz(6)

  menuItem MenuItem?        @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Cascade)
  variant  MenuItemVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@index([tenantId, menuItemId])
  @@index([tenantId, variantId])
  @@map("availability_rules")
  @@schema("catalogue")
}

/// ModifierGroup (FR-MNU-010/011, SRS §7.3 #8: min ≤ max; required ⇒ min ≥ 1).
model ModifierGroup {
  id                    String  @id @db.Uuid
  tenantId              String  @map("tenant_id") @db.Uuid
  name                  Json    @db.JsonB
  minSelections         Int     @default(0) @map("min_selections") @db.SmallInt
  maxSelections         Int     @default(1) @map("max_selections") @db.SmallInt
  isRequired            Boolean @default(false) @map("is_required")
  allowRepeat           Boolean @default(false) @map("allow_repeat")
  /// FR-MNU-011 "first two free, third charged".
  freeQuantityThreshold Int     @default(0) @map("free_quantity_threshold") @db.SmallInt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  modifiers Modifier[]
  itemLinks ModifierGroupLink[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("modifier_groups")
  @@schema("catalogue")
}

/// FR-POS-021 [M] — the three semantic kinds a modifier carries (addition,
/// removal, substitution). P1E-5. NOT inferable from price sign, name text,
/// group name, or recipeDelta (all rejected as backfill heuristics — see the
/// migration header and the P1E-5 report §C) — a modifier created before this
/// enum existed has an genuinely UNKNOWN kind, which is exactly why
/// `Modifier.kind` below is nullable rather than backfilled.
enum ModifierKind {
  addition
  removal
  substitution

  @@schema("catalogue")
}

/// P1E-3: carries `tenant_id` directly — previously a pure child of
/// ModifierGroup inheriting tenant scope only via EXISTS. `kitchen.
/// station_routing_rules` (FR-KDS-010 tier 2 — modifier routing) needs a
/// tenant-safe composite FK to a modifier, and a tenant-safe FK target
/// requires `UNIQUE (tenant_id, id)` on this table (ADR 0008 D-09: "For
/// children that carry no tenant_id... anchor sibling references on the
/// branch composite instead" — Modifier has no branch to anchor on, so this
/// is the direct alternative). `sales.order_line_modifiers.modifier_id` gains
/// the same tenant-safe FK for the identical reason (P1E-2 §F).
model Modifier {
  id                  String        @id @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  modifierGroupId     String        @map("modifier_group_id") @db.Uuid
  name                Json          @db.JsonB
  /// Minor units; may be negative (e.g. "Chicken instead of Beef" = -300).
  priceDelta          BigInt        @default(0) @map("price_delta")
  /// FR-POS-021 [M]. Nullable: P1E-5 could not safely backfill 18 pre-existing
  /// rows (no non-heuristic source data distinguishes their kind — see the
  /// migration header). Every row created through `ModifierGroupsService.
  /// addModifier` from this slice forward MUST supply a value; the service
  /// layer, not the database, enforces "new writes require kind" (a NOT NULL
  /// column would also reject the legacy rows' own future updates that don't
  /// touch this column).
  kind                ModifierKind?
  /// FR-MNU-012 [M] stock linkage. FK-less recorded UUIDs — Inventory is out of
  /// scope, so the requirement stays functionally unmet (documented).
  stockItemId         String?       @map("stock_item_id") @db.Uuid
  consumptionQuantity Decimal?      @map("consumption_quantity") @db.Decimal(18, 6)
  consumptionUnitId   String?       @map("consumption_unit_id") @db.Uuid
  /// FR-MNU-013 [S]. Opaque JSON — Production Spec is NOT implemented; nothing
  /// in this phase interprets or executes a recipe delta.
  recipeDelta         Json?         @map("recipe_delta") @db.JsonB
  isDefault           Boolean       @default(false) @map("is_default")
  sortOrder           Int           @default(0) @map("sort_order") @db.SmallInt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  /// D-09 composite FK — a modifier can never point at another tenant's group.
  group  ModifierGroup @relation(fields: [tenantId, modifierGroupId], references: [tenantId, id], onDelete: Cascade)

  orderLineModifiers  OrderLineModifier[]
  stationRoutingRules StationRoutingRule[]
  ticketLineModifiers TicketLineModifier[]
  // P1F-2 back-relation only (virtual; no DDL impact on this model).
  recipeEffects       ModifierRecipeEffect[]

  @@unique([tenantId, id])
  @@index([tenantId, modifierGroupId])
  @@map("modifiers")
  @@schema("catalogue")
}

/// FR-MNU-010: reusable group attached to an item, with per-item overrides.
model ModifierGroupLink {
  tenantId                 String @map("tenant_id") @db.Uuid
  menuItemId               String @map("menu_item_id") @db.Uuid
  modifierGroupId          String @map("modifier_group_id") @db.Uuid
  priceOverride            Json?  @map("price_override") @db.JsonB
  defaultSelectionOverride Json?  @map("default_selection_override") @db.JsonB
  sortOrder                Int    @default(0) @map("sort_order") @db.SmallInt

  menuItem MenuItem      @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [tenantId, modifierGroupId], references: [tenantId, id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@index([tenantId, modifierGroupId])
  @@map("modifier_group_links")
  @@schema("catalogue")
}

/// PriceList (FR-MNU-020/021/022/023, SRS §7.3 #10).
/// C-06: scope is tenant | brand | branch only. `scopeId` stays polymorphic per
/// the approved SQL and is validated in the service layer against the acting
/// tenant (no FK is possible across three target tables).
model PriceList {
  id             String         @id @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  name           String         @db.VarChar(120)
  scopeType      PriceListScope @map("scope_type")
  scopeId        String?        @map("scope_id") @db.Uuid
  /// FR-MNU-021; NULL = all order types.
  orderType      String?        @map("order_type") @db.VarChar(16)
  validFrom      DateTime?      @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime?      @map("valid_to") @db.Timestamptz(6)
  /// FR-MNU-022 recurrence; opaque per the approved SQL.
  recurrenceRule Json?          @map("recurrence_rule") @db.JsonB
  priority       Int            @default(0) @db.SmallInt
  status         String         @default("scheduled") @db.VarChar(16)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  entries PriceEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, name], map: "uq_price_list_name")
  @@index([tenantId, scopeType, scopeId])
  @@map("price_lists")
  @@schema("catalogue")
}

/// PriceEntry — a variant's price within a price list.
/// C-10: there is deliberately NO `price_change_history` table; the
/// tamper-evident governance audit trail is the system of record for
/// FR-MNU-024's price history.
model PriceEntry {
  id                String @id @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  priceListId       String @map("price_list_id") @db.Uuid
  menuItemVariantId String @map("menu_item_variant_id") @db.Uuid
  /// Minor units (SRS: money is BIGINT, never float).
  price             BigInt
  currency          String @db.Char(3)

  priceList PriceList       @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Cascade)
  variant   MenuItemVariant @relation(fields: [tenantId, menuItemVariantId], references: [tenantId, id])

  /// Implementation hardening (§12): without this a variant could hold several
  /// contradictory prices in one list, corrupting price resolution.
  @@unique([tenantId, priceListId, menuItemVariantId], map: "uq_price_entry")
  @@index([tenantId, menuItemVariantId])
  @@map("price_entries")
  @@schema("catalogue")
}

/// Employee — the MINIMAL substrate authorised by the D-2 amendment for P0 PIN.
///
/// SRS §7.3 #25 defines the Employee aggregate ("May link to at most one User")
/// and §14 distinguishes an Employee (a person in a job) from a User (a login).
/// `FR-HRM-001` [M] names "permitted branches" and `FR-HRM-005` [M] requires a
/// designated home branch — the two facts `FR-SEC-021` depends on.
///
/// SCOPE: this is NOT the full FR-HRM-001 employee record. No employment terms,
/// compensation, certifications, documents, scheduling or attendance. Those stay
/// deferred; FR-HRM-001 is therefore PARTIAL by construction, not by oversight.
model Employee {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  /// At most one User (SRS §7.3 #25). NULL = an employee who cannot sign in.
  userId       String?        @unique @map("user_id") @db.Uuid
  code         String         @db.VarChar(32)
  displayName  String         @map("display_name") @db.VarChar(120)
  /// FR-HRM-005 designated home branch.
  homeBranchId String         @map("home_branch_id") @db.Uuid
  status       EmployeeStatus @default(active)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  homeBranch Branch           @relation("EmployeeHomeBranch", fields: [tenantId, homeBranchId], references: [tenantId, id], onDelete: Restrict)
  branches   EmployeeBranch[]

  // P1D-1: the employee is the business financial actor (carried item P1D-E).
  shifts                Shift[]
  cashSessions          CashSession[]
  orderPayments         OrderPayment[]
  // P1G-0 back-relation only (virtual; no DDL impact on this model).
  cashMovements         CashMovement[]
  // P1G-1 migration 34 back-relations only (virtual; no DDL impact).
  closeAttemptsDeclared CashSessionCloseAttempt[] @relation("CloseAttemptDeclaredByEmployee")
  cashSessionsClosedBy  CashSession[]             @relation("CashSessionClosedByEmployee")
  // Migration 35 back-relations only (virtual; no DDL impact on this model).
  dayCloseActivationsMade DayCloseActivation[]
  dayClosesClosed         DayClose[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], map: "uq_employee_code")
  @@index([tenantId, homeBranchId])
  @@map("employees")
  @@schema("identity")
}

enum EmployeeStatus {
  active
  suspended
  terminated

  @@schema("identity")
}

/// FR-HRM-005: employees are assignable to multiple branches. This is the
/// permitted-branch set FR-SEC-021 checks a PIN against. It is authentication
/// integrity only — it does NOT grant permissions and does NOT implement
/// FR-SEC-002/003/004 branch-scoped RBAC, which D-2 still defers.
model EmployeeBranch {
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([employeeId, branchId])
  @@index([tenantId, branchId])
  @@map("employee_branches")
  @@schema("identity")
}

/// Reusable API idempotency record — SRS §26.5 (FR-API-020…023).
///
/// Deviates from the approved SQL in two documented ways, both required by the
/// requirements themselves: the key is scoped `(tenantId, key)` rather than
/// globally unique (the approved shape would collide — and could replay —
/// across tenants), and `fingerprint` is added because FR-API-022/023 cannot be
/// satisfied without it. See the migration for the full reasoning.
model IdempotencyKey {
  tenantId       String    @map("tenant_id") @db.Uuid
  key            String    @db.VarChar(80)
  /// Operation identity, so one client key reused on a different endpoint is a
  /// conflict rather than a silent cross-operation replay.
  endpoint       String    @db.VarChar(120)
  /// SHA-256 hex over a canonical rendering of the request.
  fingerprint    String    @db.Char(64)
  /// `in_flight` while the handler runs; `completed` once the response is stored.
  state          String    @default("in_flight") @db.VarChar(16)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body") @db.JsonB
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  /// FR-API-021 — retained at least 30 days.
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("sync")
}

// ---------------------------------------------------------------------------
// P1A — Sales Order capture foundation.
//
// `orders` and `order_lines` are monthly RANGE-partitioned on `business_day`
// (FR-DR-001). PostgreSQL requires the partition key inside every unique
// constraint, hence the composite ids below — `id` is still the permanent
// client-generated ULID (FR-OFF-015); the composite is a storage requirement,
// not a second identity.
//
// See the migration header for the documented deviations from the approved SQL
// (absent crm/treasury/sync contexts, and the two NOT NULL columns whose
// producers do not exist yet).
// ---------------------------------------------------------------------------

enum OrderType {
  dine_in
  takeaway
  delivery
  drive_thru
  pickup
  aggregator

  @@schema("sales")
}

enum OrderChannel {
  pos
  kiosk
  qr
  aggregator
  phone
  api

  @@schema("sales")
}

enum OrderState {
  draft
  open
  held
  parked
  partially_paid
  completed
  cancelled
  partially_refunded
  refunded

  @@schema("sales")
}

enum OrderLineState {
  pending
  fired
  preparing
  ready
  served
  voided
  comped

  @@schema("sales")
}

/// P1F-1 — FR-POS-060 MVP scope: only the two tenders this slice implements.
/// The SRS names eleven; adding the other nine here would be appearance
/// without capability (no capture path would ever produce them).
enum OrderPaymentTender {
  cash
  manual_external_card

  @@schema("sales")
}

model Order {
  id                 String       @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  branchId           String       @map("branch_id") @db.Uuid
  terminalId         String       @map("terminal_id") @db.Uuid
  /// FR-POS-002 `<branch_code>-<business_day_seq>`, drawn from a terminal block.
  orderNumber        String       @map("order_number") @db.VarChar(24)
  businessDay        DateTime     @map("business_day") @db.Date
  orderType          OrderType    @map("order_type")
  channel            OrderChannel
  state              OrderState   @default(draft)
  tableId            String?      @map("table_id") @db.Uuid
  guestCount         Int?         @map("guest_count") @db.SmallInt
  openedBy           String       @map("opened_by") @db.Uuid
  servedBy           String?      @map("served_by") @db.Uuid
  closedBy           String?      @map("closed_by") @db.Uuid
  currency           String       @db.Char(3)
  subtotal           BigInt       @default(0)
  discountTotal      BigInt       @default(0) @map("discount_total")
  serviceChargeTotal BigInt       @default(0) @map("service_charge_total")
  taxTotal           BigInt       @default(0) @map("tax_total")
  roundingAdjustment BigInt       @default(0) @map("rounding_adjustment")
  grandTotal         BigInt       @default(0) @map("grand_total")
  paidTotal          BigInt       @default(0) @map("paid_total")
  tipTotal           BigInt       @default(0) @map("tip_total")
  cogsTotal          BigInt?      @map("cogs_total")
  openedAt           DateTime     @map("opened_at") @db.Timestamptz(6)
  firstFiredAt       DateTime?    @map("first_fired_at") @db.Timestamptz(6)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(6)
  originDeviceTime   DateTime     @map("origin_device_time") @db.Timestamptz(6)
  idempotencyKey     String       @map("idempotency_key") @db.VarChar(80)
  aggregatorRef      String?      @map("aggregator_ref") @db.VarChar(80)
  /// No authoritative CountryPack source exists yet; see the migration header.
  countryPackVersion String       @map("country_pack_version") @db.VarChar(24)
  notes              String?
  metadata           Json         @default("{}") @db.JsonB
  /// §24.6.4 optimistic concurrency.
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  lines                OrderLine[]
  lineStationOverrides OrderLineStationOverride[]
  tickets              Ticket[]
  payments             OrderPayment[]

  @@id([id, businessDay])
  @@unique([tenantId, id, businessDay])
  /// P1E-3 (K-1) — additive index-only target so `sales.
  /// order_line_station_overrides` can carry a composite FK that proves its
  /// `branch_id` is genuinely this order's branch. No column added.
  @@unique([tenantId, id, businessDay, branchId], map: "uq_orders_tenant_id_business_day_branch")
  @@unique([branchId, businessDay, orderNumber], map: "uq_order_number")
  @@unique([tenantId, idempotencyKey, businessDay], map: "uq_orders_idempotency")
  @@index([tenantId, branchId, businessDay])
  @@index([tenantId, state])
  @@map("orders")
  @@schema("sales")
}

model OrderLine {
  id               String         @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  businessDay      DateTime       @map("business_day") @db.Date
  sequence         Int            @db.SmallInt
  menuItemId       String         @map("menu_item_id") @db.Uuid
  variantId        String         @map("variant_id") @db.Uuid
  /// BR-POS-004 sale-time snapshots — never recomputed from master data.
  itemNameSnapshot Json           @map("item_name_snapshot") @db.JsonB
  quantity         Decimal        @db.Decimal(12, 3)
  unitPrice        BigInt         @map("unit_price")
  modifierTotal    BigInt         @default(0) @map("modifier_total")
  lineDiscount     BigInt         @default(0) @map("line_discount")
  lineSubtotal     BigInt         @map("line_subtotal")
  taxClassId       String         @map("tax_class_id") @db.Uuid
  taxAmount        BigInt         @default(0) @map("tax_amount")
  lineTotal        BigInt         @map("line_total")
  unitCostSnapshot BigInt?        @map("unit_cost_snapshot")
  recipeVersionId  String?        @map("recipe_version_id") @db.Uuid
  /// P1F-2 — exact bigint SUM of this line's Inventory ALLOCATION total_cost
  /// values, written ONLY by Order Completion. Absent recipe posts 0 (never
  /// NULL). NULL = not yet completed. No rounding at this level (FR-CST-002).
  postedCogsTotal  BigInt?        @map("posted_cogs_total")
  /// FR-POS-042 price provenance.
  priceListId      String?        @map("price_list_id") @db.Uuid
  priceEntryId     String?        @map("price_entry_id") @db.Uuid
  priceRule        String?        @map("price_rule") @db.VarChar(160)
  course           Int?           @db.SmallInt
  seatNumber       Int?           @map("seat_number") @db.SmallInt
  state            OrderLineState @default(pending)
  firedAt          DateTime?      @map("fired_at") @db.Timestamptz(6)
  readyAt          DateTime?      @map("ready_at") @db.Timestamptz(6)
  voidReasonId     String?        @map("void_reason_id") @db.Uuid
  voidedBy         String?        @map("voided_by") @db.Uuid
  isComp           Boolean        @default(false) @map("is_comp")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  order            Order                      @relation(fields: [tenantId, orderId, businessDay], references: [tenantId, id, businessDay], onDelete: Cascade)
  modifiers        OrderLineModifier[]
  stationOverrides OrderLineStationOverride[]
  ticketLines      TicketLine[]

  // P1F-2 line-capture snapshots (virtual; no DDL impact on this model).
  recipeVersionPins    OrderLineRecipeVersion[]
  modifierEffectPins   OrderLineModifierEffect[]
  componentConversions OrderLineComponentConversion[]
  // P1F-2 Inventory back-relation (virtual; no DDL impact on this model).
  depletionEffects     SaleDepletionEffect[]

  @@id([id, businessDay])
  @@unique([tenantId, id, businessDay])
  @@unique([tenantId, orderId, businessDay, sequence], map: "uq_order_line_sequence")
  /// P1E-3 (K-1) — additive index-only target so an override can prove the
  /// exact chain "this line belongs to this order" via the composite FK.
  @@unique([tenantId, orderId, id, businessDay], map: "uq_order_lines_tenant_order_id_business_day")
  @@index([tenantId, orderId, businessDay])
  @@map("order_lines")
  @@schema("sales")
}

model OrderLineModifier {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  orderLineId     String        @map("order_line_id") @db.Uuid
  businessDay     DateTime      @map("business_day") @db.Date
  modifierId      String        @map("modifier_id") @db.Uuid
  modifierGroupId String        @map("modifier_group_id") @db.Uuid
  nameSnapshot    Json          @map("name_snapshot") @db.JsonB
  /// FR-POS-021 [M] / BR-POS-004 sale-time snapshot of `Modifier.kind`.
  /// Nullable for the identical reason `Modifier.kind` is nullable: a line
  /// captured against a legacy, unclassified Modifier snapshots that
  /// unknown-ness rather than inventing a value. P1E-5: `OrderLinesService`
  /// copies the source Modifier's `kind` verbatim at capture time — never
  /// re-derived, never defaulted.
  kindSnapshot    ModifierKind? @map("kind_snapshot")
  priceDelta      BigInt        @default(0) @map("price_delta")
  quantity        Int           @default(1) @db.SmallInt
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  line                        OrderLine                 @relation(fields: [tenantId, orderLineId, businessDay], references: [tenantId, id, businessDay], onDelete: Cascade)
  /// P1E-3: was FK-less (Catalogue `modifiers` had no `tenant_id` to compose
  /// with). D-09 composite FK — a captured selection can never point at
  /// another tenant's modifier. `ON DELETE RESTRICT`: a modifier referenced by
  /// sale history must not disappear out from under it (unlike the line's own
  /// cascade, which follows the ORDER's lifecycle, not the catalogue's).
  modifier                    Modifier                  @relation(fields: [tenantId, modifierId], references: [tenantId, id], onDelete: Restrict)
  /// P1E-5 back-relation only — Kitchen's FK to this row is integrity-only
  /// (idempotency key), never a live read path from this side either.
  ticketLineModifierSnapshots TicketLineModifier[]
  // P1F-2 back-relation only (virtual; no DDL impact on this model).
  recipeEffectPins            OrderLineModifierEffect[]

  @@unique([tenantId, id])
  @@index([tenantId, orderLineId])
  @@index([tenantId, modifierId])
  @@map("order_line_modifiers")
  @@schema("sales")
}

/// FR-KDS-010 tier 1 (explicit line-level station override). P1E-3 addition —
/// 0..N stations per line (FR-KDS-011). NOT partitioned: a leaf reached only
/// through its line, same pattern as `OrderLineModifier`. Not in FR-DR-001's
/// partition list. Three composite FKs together make it PostgreSQL-provable
/// that: the override belongs to the line; the line belongs to the order; the
/// override's `branch_id` IS the order's branch (K-1 — additive unique
/// indexes on `orders`/`order_lines`, no `branch_id` column added to every
/// line); and the station belongs to that same branch.
model OrderLineStationOverride {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  orderLineId String   @map("order_line_id") @db.Uuid
  businessDay DateTime @map("business_day") @db.Date
  branchId    String   @map("branch_id") @db.Uuid
  stationId   String   @map("station_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  /// Proves branch_id IS the order's branch.
  order   Order     @relation(fields: [tenantId, orderId, businessDay, branchId], references: [tenantId, id, businessDay, branchId], onDelete: Cascade)
  /// Proves this line belongs to that same order.
  line    OrderLine @relation(fields: [tenantId, orderId, orderLineId, businessDay], references: [tenantId, orderId, id, businessDay], onDelete: Cascade)
  /// Proves the station belongs to the same branch as the order.
  station Station   @relation(fields: [branchId, stationId], references: [branchId, id], onDelete: Restrict)

  @@unique([tenantId, orderLineId, businessDay, stationId], map: "uq_order_line_station_overrides_line_station")
  @@index([tenantId, orderLineId, businessDay])
  @@map("order_line_station_overrides")
  @@schema("sales")
}

/// P1F-1 — Payment MVP: partial CASH + manual/external card capture.
///
/// APPEND-ONLY (ADR-010, P1D-C): `ros_app` holds SELECT + INSERT only, no
/// UPDATE, no DELETE — enforced at the database, the same pattern
/// `governance.audit_entries` already uses. There is no mutable `status`
/// column: P1D-C draws the successful-Payment / PaymentAttempt line exactly
/// here, and CASH and MANUAL_EXTERNAL_CARD in this MVP have no
/// PaymentAttempt at all (the cashier already completed the card
/// transaction independently; ROS records the successful result).
///
/// `amount` is what this Payment contributes to `orders.paid_total` — the
/// EXACT amount settled, never the cash-rounded figure. `roundingAdjustment`
/// is a SEPARATE, purely cash-drawer-reconciliation figure (FR-FIN-004's "±
/// Cash Rounding Adjustments" term); it is never added to `paid_total` and
/// never absorbed into revenue or tax (BR-FIN-004). This matches the SRS's
/// own `Order.complete()` reference pseudocode (§24.2.4), which compares
/// `paid` against `grandTotal` with no rounding term at all.
///
/// P1D-B: this row — not `orders.cash_session_id`, which does not exist —
/// is the sole source of truth for session attribution; an Order may carry
/// many Payments across many sessions. P1D-D: cash rounding is persisted
/// PER PAYMENT, here. P1D-E: `employeeId` is the financial actor. P1D-G:
/// both CASH and MANUAL_EXTERNAL_CARD are attributed to a CashSession for
/// FR-FIN-010 tender-total accountability, but only CASH ever touches
/// physical expected cash (enforced below: MANUAL_EXTERNAL_CARD's
/// `roundingAdjustment` is CHECK-constrained to zero and it carries no
/// tendered/change fields).
///
/// FR-POS-066: no PAN, CVV, track/magstripe data — there is no field that
/// could hold one. Only last 4, scheme, authorisation code and terminal
/// reference are retained, exactly SRS FR-POS-066's permitted list.
model OrderPayment {
  id          String   @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  /// Copied from the order so this row can carry a tenant-safe composite FK
  /// to the partitioned `orders` table (the same pattern `order_lines` and
  /// `order_line_station_overrides` already use).
  businessDay DateTime @map("business_day") @db.Date

  tender OrderPaymentTender

  /// Snapshot of the order's currency at capture time. Never client-supplied.
  currency           String @db.Char(3)
  /// The EXACT amount this Payment contributes to `orders.paid_total`.
  /// Minor units. NEVER the cash-rounded figure — see the model doc comment.
  amount             BigInt
  /// FR-POS-063 / BR-FIN-004 — CASH only. Zero for MANUAL_EXTERNAL_CARD
  /// (CHECK-enforced). The gap between the cash actually due (rounded to
  /// the pinned country pack's step) and `amount`; never part of
  /// `paid_total`.
  roundingAdjustment BigInt @default(0) @map("rounding_adjustment")

  /// P1D-B/D/E/G attribution. Tenant-safe FK below; branch/employee/
  /// terminal/currency/open-status are validated at capture time through
  /// Treasury's public `CashSessionFactsQuery` contract (SRS §5.4) — see
  /// `sales-payment.service.ts`.
  cashSessionId String @map("cash_session_id") @db.Uuid
  /// P1D-E — the business financial actor. The trusted PIN-session
  /// employee, never client-supplied.
  employeeId    String @map("employee_id") @db.Uuid
  /// The trusted terminal the capture happened at. Never client-supplied.
  terminalId    String @map("terminal_id") @db.Uuid

  // ── CASH-specific (FR-POS-063) ──────────────────────────────────────────
  /// What the customer physically handed over. NULL for MANUAL_EXTERNAL_CARD.
  tenderedAmount BigInt? @map("tendered_amount")
  /// `tenderedAmount - (amount + roundingAdjustment)`. NULL for MANUAL_EXTERNAL_CARD.
  changeGiven    BigInt? @map("change_given")

  // ── MANUAL_EXTERNAL_CARD-specific (FR-POS-066 permitted metadata only) ──
  /// Required for MANUAL_EXTERNAL_CARD. The cashier's own record of the
  /// already-completed external-terminal transaction — never a ROS-side
  /// terminal session identifier (no integrated terminal exists — FR-POS-064
  /// NOT IMPLEMENTED).
  paymentTerminalTxnRef String? @map("payment_terminal_txn_ref") @db.VarChar(64)
  /// Optional, only when the cashier supplies it.
  cardScheme            String? @map("card_scheme") @db.VarChar(32)
  /// Optional. Exactly 4 digits when present (CHECK-enforced) — never more.
  cardLast4             String? @map("card_last4") @db.VarChar(4)
  /// Optional.
  authorizationCode     String? @map("authorization_code") @db.VarChar(32)

  /// Server clock at capture. Never client-supplied.
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// RESTRICT, not CASCADE: a Payment is a separate append-only financial
  /// ledger, not part of the order's own mutable content (unlike
  /// `OrderLine`, which cascades with its order). No order-deletion path
  /// exists anywhere in this system (ADR-010), so this is a structural
  /// guarantee rather than a live concern.
  ///
  /// P1F-1A — BRANCH-INCLUSIVE, not just tenant-safe: uses the existing
  /// P1E-3 `uq_orders_tenant_id_business_day_branch` target
  /// `(tenant_id, id, business_day, branch_id)` (no new Sales index — the
  /// target already exists), so `Payment.branchId` disagreeing with the
  /// referenced Order's own `branchId` is structurally unrepresentable, not
  /// merely service-validated (ADR 0008 D-09).
  order       Order       @relation(fields: [tenantId, orderId, businessDay, branchId], references: [tenantId, id, businessDay, branchId], onDelete: Restrict)
  /// Tenant-safe FK using CashSession's existing `(tenantId, id)` unique
  /// target — the ONLY tenant-safe target `treasury.cash_sessions`
  /// currently exposes (no `(tenantId, branchId, id)` composite exists).
  /// Adding one would be a Treasury-owned migration this Sales-owned
  /// correction does not make (P1F-1A §7/H). Branch/employee/terminal/
  /// currency/open-status are validated at the service layer instead (see
  /// the model doc comment).
  cashSession CashSession @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  /// Tenant-safe composite FK, mirroring `orders.opened_by`.
  employee    Employee    @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  /// P1F-1A — BRANCH-SAFE, not the older single-column `orders.terminal_id`
  /// precedent: uses the ADR 0008 D-16 target `identity.terminals(branch_id,
  /// id)` (the same one `Drawer.terminal` already uses), so a Payment
  /// carrying branch A but a Terminal actually registered to branch B is
  /// structurally unrepresentable, not merely service-validated. This new
  /// table deliberately does not repeat the older, acknowledged
  /// `orders.terminal_id -> identity.terminals(id)` weakness merely because
  /// that precedent exists.
  terminal    Terminal    @relation(fields: [branchId, terminalId], references: [branchId, id], onDelete: Restrict)

  @@id([id])
  @@unique([tenantId, id])
  @@index([tenantId, orderId, businessDay])
  @@index([tenantId, cashSessionId])
  @@map("order_payments")
  @@schema("sales")
}

/// FR-POS-002 / FR-OFF-016 — server-issued number blocks per terminal per
/// business day. Numbers come from a held block, never MAX()+1 or a global
/// sequence, because either would require connectivity.
model OrderNumberBlock {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  terminalId  String    @map("terminal_id") @db.Uuid
  businessDay DateTime  @map("business_day") @db.Date
  blockStart  Int       @map("block_start")
  blockEnd    Int       @map("block_end")
  nextSeq     Int       @map("next_seq")
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  exhaustedAt DateTime? @map("exhausted_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([branchId, businessDay, blockStart], map: "uq_block_start")
  @@index([tenantId, branchId, terminalId, businessDay])
  @@map("order_number_blocks")
  @@schema("sales")
}

// ---------------------------------------------------------------------------
// P1D-1 — Workforce Operational Shift + Treasury Drawer / CashSession OPEN.
//
// Authorised by carried item P1D-A (2026-08-20), which reopens D-2's Workforce
// defer NARROWLY: an Operational Shift identity and lifecycle, and nothing else.
// Schedule, ScheduledShift, Attendance, clock events, breaks, leave, swaps and
// payroll all stay deferred.
//
// -- WHY SHIFT AND CASHSESSION ARE TWO TABLES -------------------------------
// SRS 5.4 lists Shift among Workforce's aggregates, the context map carries
// `Workforce --> Treasury [shift -> cash session]`, 5.5.4 makes Workforce the
// publisher of `shift.opened`, and 16.2 models a cash session as "one employee,
// one SHIFT, one drawer". The approved SQL has no `workforce.shifts` and no
// shift column on `cash_sessions` -- a physical omission, recorded as a
// documented deviation rather than read as evidence the two are one concept.
// ---------------------------------------------------------------------------

enum ShiftStatus {
  open
  closed

  @@schema("workforce")
}

/// Operational Shift - one employee's duty period at one branch.
///
/// MINIMAL by ratification. It answers "who was on duty, where, and is that
/// period still open?" and nothing else. There is no schedule link, no clock
/// event, no break, no station and no labour cost, because P1D-A authorises the
/// POS/Treasury accountability substrate only.
///
/// NOT bound to a Terminal. A shift legitimately spans devices; the terminal
/// that initiated an operation is carried on the AUDIT entry, where it belongs,
/// rather than becoming part of the shift's identity.
model Shift {
  id         String      @id @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  branchId   String      @map("branch_id") @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  status     ShiftStatus @default(open)
  openedAt   DateTime    @map("opened_at") @db.Timestamptz(6)
  /// Null while open. No close COMMAND exists yet, and `ros_app` holds no UPDATE
  /// privilege on this table, so the runtime cannot set it either.
  closedAt   DateTime?   @map("closed_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  /// D-09 composite FKs: a shift can never reference another tenant's branch or
  /// another tenant's employee.
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  cashSessions CashSession[]

  @@unique([tenantId, id])
  /// THE composite target `treasury.cash_sessions` references. Because a session
  /// must match all four columns, a session whose branch or employee disagrees
  /// with its shift is structurally impossible - not merely validated.
  @@unique([tenantId, branchId, employeeId, id], map: "uq_shift_scope")
  @@index([tenantId, branchId, status])
  @@index([tenantId, employeeId, status])
  @@map("shifts")
  @@schema("workforce")
}

/// P1G-1 migration 34 adds `closing` — the frozen state between an
/// above-tolerance immutable count declaration and its manager decision.
/// `ALTER TYPE ... ADD VALUE` — verified safe in the same migration file as
/// its use (migration-compatibility-closure report §3: Prisma Migrate 7.9.1
/// executes migration statements non-transactionally in this environment).
enum CashSessionStatus {
  open
  closing
  closed

  @@schema("treasury")
}

/// Drawer - the physical cash container (FR-FIN-001 [M], SRS 6.1 hierarchy).
///
/// A BRANCH-level master identity. It holds no balance, no float and no session
/// data: those belong to the CashSession that is open over it. Terminal binding
/// is OPTIONAL because the approved SQL makes it nullable - an unbound drawer is
/// branch-scoped and usable from any terminal in that branch.
model Drawer {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  name       String   @db.VarChar(64)
  /// NULL = not bound to a device. When set, a session may only be opened from
  /// THAT terminal. Same-branch is structural (see the composite FK below), and
  /// same-branch implies same-tenant because `branch_id` is itself tenant-safe.
  terminalId String?  @map("terminal_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  /// ADR 0008 D-16 precedent: `(branch_id, id)` on terminals is the same
  /// branch-safe target `org.stations` already uses for its display terminal.
  terminal Terminal? @relation(fields: [branchId, terminalId], references: [branchId, id], onDelete: Restrict)

  cashSessions CashSession[]

  @@unique([tenantId, id])
  /// Composite target for `cash_sessions`, so a session can never reach a drawer
  /// in another branch.
  @@unique([tenantId, branchId, id], map: "uq_drawer_scope")
  @@unique([tenantId, branchId, name], map: "uq_drawer_name")
  @@index([tenantId, branchId])
  @@map("drawers")
  @@schema("treasury")
}

/// CashSession - cash custody over one drawer, by one employee, under one shift.
///
/// SRS 16.2, FR-FIN-001/002. **OPEN ONLY** in this slice: there is no close
/// command, no counted cash, no denominations and no variance, and `ros_app`
/// holds no UPDATE privilege on this table so none of that can be written by
/// accident.
///
/// -- THE INVARIANTS, AND WHERE THEY LIVE ------------------------------------
///   one open session per drawer   PARTIAL UNIQUE INDEX (migration, raw SQL -
///                                 Prisma cannot express `WHERE status='open'`).
///                                 NOT `UNIQUE(drawer_id, status)`: that would
///                                 permit only ONE closed session per drawer
///                                 ever, which is the approved SQL's own
///                                 acknowledged defect.
///   exactly one employee          `employee_id` NOT NULL (FR-FIN-002).
///   employee matches the shift    the 4-column composite FK below.
///   branch matches drawer/shift   the composite FKs below.
///   float is exact money          BIGINT minor units + the branch's currency.
model CashSession {
  id           String            @id @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  drawerId     String            @map("drawer_id") @db.Uuid
  /// P1D-A: the Treasury -> Workforce reference. Never collapsed into this table.
  shiftId      String            @map("shift_id") @db.Uuid
  /// P1D-E: the business financial actor is the EMPLOYEE, not the login user.
  employeeId   String            @map("employee_id") @db.Uuid
  /// FR-POS-090 declared opening float, minor units (ADR-008: money is BIGINT).
  openingFloat BigInt            @map("opening_float")
  /// Snapshot of the branch's authoritative currency at open. Never client-supplied.
  currency     String            @db.Char(3)
  status       CashSessionStatus @default(open)
  openedAt     DateTime          @map("opened_at") @db.Timestamptz(6)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  /// P1G-1 migration 34. The anchor: NULL while `open`; the ONE legal
  /// attempt id while `closing`/a new `closed` (proven relationally —
  /// `cash_sessions_close_attempt_fkey` below + the attempt's own
  /// `uq_csca_one_per_session`); NULL on a pre-P1G-1 legacy `closed` row.
  closeAttemptId     String? @map("close_attempt_id") @db.Uuid
  /// FR-FIN-005 core close facts. NULL while `open`/`closing`; populated
  /// EXACTLY ONCE, at `closed`, copied FROM the immutable attempt — never a
  /// second mutable copy (design acceptance closure §3.2/§3.3).
  expectedCash       BigInt? @map("expected_cash")
  countedCash        BigInt? @map("counted_cash")
  variance           BigInt?
  /// FR-FIN-006. The reason on the FINAL, APPROVED close — never a prior
  /// rejected attempt's (R-6(a) clause 12).
  varianceReason     String? @map("variance_reason")
  /// Governance reference. Deliberately NO FK — `governance.approval_requests`
  /// is another module's table (design gate §30); Treasury never queries it
  /// directly, only through `ApprovalCommands`.
  approvalRequestId  String? @map("approval_request_id") @db.Uuid
  closedByUserId     String? @map("closed_by_user_id") @db.Uuid
  closedByEmployeeId String? @map("closed_by_employee_id") @db.Uuid
  /// Migration 35 (DayClose, DC-R2 — CLOSE-BUSINESS-DAY OWNERSHIP). Written
  /// EXACTLY ONCE, in the SAME UPDATE as the other close facts, at the
  /// CLOSED transition, from the SAME authoritative `resolveBusinessDay`
  /// resolver Sales/Order-creation uses (via `DAILY_TRADING_SALES_QUERY
  /// .currentBusinessDay`). NEVER re-derived afterwards, NEVER re-derived
  /// historically from the mutable `branch.timezone`/cutover. NULLABLE —
  /// a pre-migration-35 legacy `closed` row keeps this NULL forever: it is
  /// owned by no DayClose, never backfilled, never inferred (DC-R2 clause 8).
  closedBusinessDay  DateTime? @map("closed_business_day") @db.Date

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch                    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  /// Same tenant AND same branch as the session.
  drawer           Drawer                    @relation(fields: [tenantId, branchId, drawerId], references: [tenantId, branchId, id], onDelete: Restrict)
  /// Same tenant, branch AND employee as the session - four columns, so a
  /// mismatch is a foreign-key violation rather than a missed service check.
  shift            Shift                     @relation(fields: [tenantId, branchId, employeeId, shiftId], references: [tenantId, branchId, employeeId, id], onDelete: Restrict)
  employee         Employee                  @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  payments         OrderPayment[]
  // P1G-0 back-relation only (virtual; no DDL impact on this model).
  cashMovements    CashMovement[]
  /// P1G-1 — the session -> attempt anchor (three-column FK proving EXACT
  /// ownership, not merely same-tenancy). `onUpdate: Cascade` mirrors the
  /// migration; there is no delete path (`onDelete: Restrict`) on either side.
  closeAttempt     CashSessionCloseAttempt?  @relation("SessionAnchor", fields: [tenantId, id, closeAttemptId], references: [tenantId, cashSessionId, id], onDelete: Restrict, onUpdate: Cascade)
  /// P1G-1 back-relation only (virtual; no DDL impact on this model) — the
  /// (tenant_id, branch_id, cash_session_id) FK target the attempt's own
  /// ownership FK requires.
  closeAttempts    CashSessionCloseAttempt[] @relation("SessionOwnership")
  closedByUser     User?                     @relation("CashSessionClosedByUser", fields: [closedByUserId], references: [id], onDelete: Restrict)
  closedByEmployee Employee?                 @relation("CashSessionClosedByEmployee", fields: [tenantId, closedByEmployeeId], references: [tenantId, id], onDelete: Restrict)
  /// Migration 35 back-relation only (virtual; no DDL impact on this model).
  dayCloseLinks    DayCloseSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, id], map: "uq_cs_branch_scoped_id")
  @@index([tenantId, branchId, status])
  @@index([tenantId, shiftId])
  @@index([tenantId, employeeId])
  /// Migration 35 — DayClose's variance-owner query:
  /// `WHERE tenant_id AND branch_id AND closed_business_day = :target`.
  @@index([tenantId, branchId, closedBusinessDay], map: "cash_sessions_closed_business_day_idx")
  @@map("cash_sessions")
  @@schema("treasury")
}

/// P1G-1 migration 34 — the immutable CashSession close declaration
/// (FR-POS-094/095/097, FR-FIN-004/005). Client-generated permanent id
/// (FR-OFF-015) — the cashier's terminal assigns it at physical count
/// declaration time; the server NEVER reassigns it. Append-only: `ros_app`
/// holds SELECT + a column-level INSERT that excludes `createdAt`; no
/// UPDATE, no DELETE. Exactly one per session
/// (`uq_csca_one_per_session`) — the blind-integrity guarantee.
model CashSessionCloseAttempt {
  id            String @id @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  branchId      String @map("branch_id") @db.Uuid
  cashSessionId String @map("cash_session_id") @db.Uuid

  /// Policy snapshot, pinned at `cash_session.opened_at` (ratified R-3(a)).
  policyVersionId     String        @map("policy_version_id") @db.Uuid
  toleranceMinorUnits BigInt        @map("tolerance_minor_units")
  countMode           CashCountMode @map("count_mode")

  /// FR-FIN-004's eight expected-cash terms.
  openingFloat            BigInt @map("opening_float")
  cashSalesTotal          BigInt @map("cash_sales_total")
  /// Structurally zero at this HEAD — DB-CHECKed (`ck_csca_tips_structurally_zero_p1g1`).
  cashTipsTotal           BigInt @map("cash_tips_total")
  payInTotal              BigInt @map("pay_in_total")
  /// Structurally zero at this HEAD — DB-CHECKed (`ck_csca_refunds_structurally_zero_p1g1`).
  cashRefundsTotal        BigInt @map("cash_refunds_total")
  payOutTotal             BigInt @map("pay_out_total")
  safeDropTotal           BigInt @map("safe_drop_total")
  cashRoundingAdjustments BigInt @map("cash_rounding_adjustments")

  /// Computed. `ck_csca_formula`/`ck_csca_variance` DB-enforce these against
  /// the eight terms above — a historical close explains itself with no
  /// join to current settings (FR-FIN-007).
  expectedCash     BigInt  @map("expected_cash")
  countedCash      BigInt  @map("counted_cash")
  variance         BigInt
  currency         String  @db.Char(3)
  /// Ratified R-2(a): `abs(variance) > tolerance`. DB-mirrored overflow-safe.
  approvalRequired Boolean @map("approval_required")

  declaredByEmployeeId String   @map("declared_by_employee_id") @db.Uuid
  declaredByUserId     String   @map("declared_by_user_id") @db.Uuid
  terminalId           String   @map("terminal_id") @db.Uuid
  /// Device event instant (caller-supplied) — distinct from `createdAt`
  /// (DB persistence provenance, un-forgeable).
  declaredAt           DateTime @map("declared_at") @db.Timestamptz(6)
  createdAt            DateTime @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The (tenant_id, branch_id, cash_session_id) target the ownership FK
  /// proves against — "SessionOwnership" is deliberately the INVERSE
  /// direction of CashSession's own "SessionAnchor" relation above (Prisma
  /// requires two distinct named relations between the same two models).
  session            CashSession             @relation("SessionOwnership", fields: [tenantId, branchId, cashSessionId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Cascade)
  policy             CashClosePolicy         @relation(fields: [tenantId, branchId, policyVersionId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Cascade)
  declaredByEmployee Employee                @relation("CloseAttemptDeclaredByEmployee", fields: [tenantId, declaredByEmployeeId], references: [tenantId, id], onDelete: Restrict)
  declaredByUser     User                    @relation("CloseAttemptDeclaredByUser", fields: [declaredByUserId], references: [id], onDelete: Restrict)
  terminal           Terminal                @relation(fields: [branchId, terminalId], references: [branchId, id], onDelete: Restrict)
  denominations      CashCountDenomination[]
  /// Inverse of CashSession's own `closeAttempt` lookup (Prisma requires
  /// both sides of the "SessionAnchor" relation to be declared).
  anchoredSessions   CashSession[]           @relation("SessionAnchor")

  @@unique([tenantId, id])
  @@unique([tenantId, cashSessionId], map: "uq_csca_one_per_session")
  @@unique([tenantId, cashSessionId, id], map: "uq_csca_session_scoped_id")
  @@index([tenantId, branchId])
  @@map("cash_session_close_attempts")
  @@schema("treasury")
}

/// P1G-1 migration 34 — denomination-level counting (FR-POS-097). Composite
/// identity — the row IS its own duplicate-denomination guard, so no
/// synthetic id exists. Append-only.
model CashCountDenomination {
  tenantId               String @map("tenant_id") @db.Uuid
  closeAttemptId         String @map("close_attempt_id") @db.Uuid
  denominationMinorUnits BigInt @map("denomination_minor_units")
  quantity               Int

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempt CashSessionCloseAttempt @relation(fields: [tenantId, closeAttemptId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tenantId, closeAttemptId, denominationMinorUnits])
  @@map("cash_count_denominations")
  @@schema("treasury")
}

/// P1G-0 — mid-shift cash movements (FR-POS-091 [M]). Exactly three types;
/// no substitution/adjustment/reversal type exists — see the design gate's
/// §12 for why a correction is NOT SOURCE-DECIDABLE and is not invented here.
enum CashMovementType {
  pay_in
  pay_out
  safe_drop

  @@schema("treasury")
}

/// CashMovement - an immutable, append-only source fact feeding the
/// Pay-ins/Pay-outs/Safe-Drops terms of FR-FIN-004's expected-cash formula.
/// `drawer_id`/`shift_id` are deliberately NOT copied here: both are
/// immutably reachable through `cash_session_id` (design gate §7).
model CashMovement {
  id            String           @id @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  branchId      String           @map("branch_id") @db.Uuid
  cashSessionId String           @map("cash_session_id") @db.Uuid
  /// P1D-E: the accountable business actor is the EMPLOYEE, not the login user.
  employeeId    String           @map("employee_id") @db.Uuid
  movementType  CashMovementType @map("movement_type")
  /// POSITIVE magnitude, minor units (design gate §2). The type column
  /// supplies the sign; a client can never submit a negative amount.
  amount        BigInt
  currency      String           @db.Char(3)
  /// FR-POS-091 [M] literal: "each with reason and amount" — mandatory for
  /// ALL THREE movement types.
  reason        String
  occurredAt    DateTime         @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The identity USER who transmitted the movement (mirrors
  /// inventory.stock_movements.performed_by), distinct from employeeId.
  performedBy   String           @map("performed_by") @db.Uuid

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  cashSession     CashSession @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  employee        Employee    @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  performedByUser User        @relation(fields: [performedBy], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId, cashSessionId])
  @@index([tenantId, branchId, occurredAt])
  @@map("cash_movements")
  @@schema("treasury")
}

/// P1G-1 migration 33 — branch-scoped, effective-dated, IMMUTABLE cash-close
/// policy (FR-FIN-006 tolerance, FR-POS-094/095 count mode, R-4(a) approval
/// expiry duration). Authority: the 2026-08-30 design gate + the "P1G-1
/// Cash-Close Policy Ratification — 2026-08-30" register entry.
///
/// NOT the generic FR-PLT-025 six-level settings hierarchy and NOT the
/// FR-PLT-026 lock mechanism — both remain NOT IMPLEMENTED; see the
/// migration's own `COMMENT ON TABLE`. Branch-scoped only.
///
/// Immutable: `ros_app` holds SELECT + a column-level INSERT that excludes
/// `createdAt` — no UPDATE, no DELETE, no TRUNCATE (the
/// `governance.approval_decisions` precedent). A new configuration is always
/// a NEW row, never an edit.
enum CashCountMode {
  blind
  open

  @@schema("treasury")
}

model CashClosePolicy {
  id                            String        @id @db.Uuid
  tenantId                      String        @map("tenant_id") @db.Uuid
  branchId                      String        @map("branch_id") @db.Uuid
  /// C-2 anti-backdating: `DEFAULT statement_timestamp()`, identical within
  /// one INSERT to `createdAt`'s own default (Postgres evaluates
  /// `statement_timestamp()` once per statement), so an "effective
  /// immediately" write satisfies `ck_ccp_no_backdating` by equality using
  /// DATABASE time only.
  effectiveFrom                 DateTime      @default(dbgenerated("statement_timestamp()")) @map("effective_from") @db.Timestamptz(6)
  /// FR-POS-095 [M] states the default explicitly — genuine DB `DEFAULT`,
  /// exact precedent: `BranchKdsConfig.recallWindowSeconds` for FR-KDS-025.
  countMode                     CashCountMode @default(blind) @map("count_mode")
  /// R-1(a): absolute money, minor units. NO DEFAULT — FR-FIN-006 names no
  /// value and none is invented. Absence of a ROW (not a column default) is
  /// how "unconfigured" is represented (R-5).
  varianceToleranceMinorUnits   BigInt        @map("variance_tolerance_minor_units")
  /// R-1(a): the branch's operational currency at the time this version was
  /// created (BR-CORE-001 — never floating money, never assumed).
  currency                      String        @db.Char(3)
  /// R-4(a): configured positive duration. NO DEFAULT — no 5m/15m/30m
  /// constant is authorised anywhere in this codebase.
  varianceApprovalExpirySeconds Int           @map("variance_approval_expiry_seconds")
  /// The Identity USER who created this version. Untenanted global FK,
  /// mirroring `CashMovement.performedBy` / `StockMovement.performedBy`.
  createdBy                     String        @map("created_by") @db.Uuid
  createdAt                     DateTime      @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch                    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  createdByUser User                      @relation(fields: [createdBy], references: [id])
  /// P1G-1 migration 34 back-relation only (virtual; no DDL impact on this
  /// model) — the (tenant_id, branch_id, id) target the close attempt's own
  /// policy-ownership FK requires.
  closeAttempts CashSessionCloseAttempt[]

  @@unique([tenantId, id])
  /// C-2 / test 21: the deterministic conflict for a concurrent same-branch,
  /// same-instant race — no advisory lock needed.
  @@unique([tenantId, branchId, effectiveFrom], map: "uq_ccp_branch_effective_from")
  /// P1G-1 migration 34 — the target the close attempt's policy-ownership FK
  /// requires (proving the policy belongs to the SAME branch as the attempt).
  @@unique([tenantId, branchId, id], map: "uq_ccp_branch_scoped_id")
  @@index([tenantId, branchId, effectiveFrom(sort: Desc)], map: "cash_close_policies_resolve_idx")
  @@map("cash_close_policies")
  @@schema("treasury")
}

// ---------------------------------------------------------------------------
// Migration 35 — DayClose (FR-FIN-020/021/023/024, Internal-MVP; DC-R1/R2/R3,
// docs/governance/GOVERNANCE_DECISION_REGISTER.md "Day Close Ratification —
// 2026-08-31"). Insert-once, immutable, append-only. See the migration's own
// header comment for the full authority chain and design rationale.
// ---------------------------------------------------------------------------

/// The immutable per-(tenant, branch) DayClose activation epoch. Created
/// lazily and idempotently on the FIRST DayClose POST for a branch, inside
/// that command's own transaction, on a path that COMMITS (never throws) —
/// see `day-close.service.ts`. `activationBusinessDay` is NEVER closeable;
/// `firstEligibleBusinessDay = activationBusinessDay + 1` is derived, never
/// stored. No UPDATE/DELETE grant — immutable forever.
model DayCloseActivation {
  id                     String    @id @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  branchId               String    @map("branch_id") @db.Uuid
  activationBusinessDay  DateTime  @map("activation_business_day") @db.Date
  activatedAt            DateTime  @default(dbgenerated("statement_timestamp()")) @map("activated_at") @db.Timestamptz(6)
  activatedBy            String    @map("activated_by") @db.Uuid
  /// P1D-E actor provenance, when the activating request was POS-originated
  /// (`@AllowPosSession`). NULL for a dashboard-originated activation — no
  /// employee identity exists for that session type.
  activatedByEmployeeId  String?   @map("activated_by_employee_id") @db.Uuid

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  activatedByUser    User     @relation(fields: [activatedBy], references: [id], onDelete: Restrict)
  activatedByEmployeeRef Employee? @relation(fields: [tenantId, activatedByEmployeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  /// Exactly one activation row per branch, forever.
  @@unique([tenantId, branchId], map: "uq_day_close_activations_branch")
  @@map("day_close_activations")
  @@schema("treasury")
}

/// The immutable DayClose / Z root — FR-FIN-020/023. Insert-once: no status
/// column, no `version` (§24.6.4's OCC clause governs UPDATEs; this
/// aggregate never has one — see the migration's header). One row per
/// `(tenant, branch, business_day)`; `zNumber` sequential per
/// `(tenant, branch)`, starting at 1, `MAX+1` inside the closing
/// transaction, `UNIQUE` as the structural backstop (FR-FIN-023).
///
/// `discountsMinor`/`refundsMinor`/`compLineCount`/`compLineValueMinor` are
/// DB-CHECKed to `0` — structurally zero at this HEAD (DC-R1 clause 3; no
/// discount or comp mechanism exists). THE SLICE THAT IMPLEMENTS EITHER
/// MUST EXPLICITLY DROP THE CORRESPONDING CHECK.
model DayClose {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  branchId String   @map("branch_id") @db.Uuid

  businessDay DateTime @map("business_day") @db.Date
  /// FR-FIN-023 — sequential per (tenant, branch), starting at 1, never reset.
  zNumber     BigInt   @map("z_number")

  /// `transaction_timestamp()` of the closing transaction — FR-RPT-004's
  /// "as of" convention, reused verbatim from the accepted Reporting slice.
  dataAsOf  DateTime @map("data_as_of") @db.Timestamptz(6)
  closedAt  DateTime @default(dbgenerated("statement_timestamp()")) @map("closed_at") @db.Timestamptz(6)
  closedBy  String   @map("closed_by") @db.Uuid
  /// P1D-E. NULL only for a dashboard-originated close (no PIN/employee
  /// identity on that session type — §17 of the design gate).
  closedByEmployeeId String? @map("closed_by_employee_id") @db.Uuid

  /// Historical transaction currency (ADR-008/BR-CORE-001) — never
  /// re-derived from today's mutable `org.branches.base_currency`.
  currency String @db.Char(3)

  // ── Sales Summary (FR-FIN-022 class A/B) ─────────────────────────────────
  grossSalesMinor              BigInt @map("gross_sales_minor")
  /// Structurally `0` at this HEAD — no discount mechanism exists (§9 CHECK).
  discountsMinor                BigInt @map("discounts_minor")
  /// Structurally `0` at this HEAD — no inbound transition to
  /// refunded/partially_refunded exists (§9 CHECK).
  refundsMinor                  BigInt @map("refunds_minor")
  taxTotalMinor                 BigInt @map("tax_total_minor")
  /// `gross - discounts - refunds - tax` (FR-CST-003, DB-CHECKed).
  netSalesMinor                 BigInt @map("net_sales_minor")
  completedOrderCount           Int    @map("completed_order_count")
  /// `netSales / completedOrderCount`, HALF_UP — `NULL` at zero count
  /// (RPT-R3's own convention, reused verbatim).
  averageOrderValueMinor        BigInt? @map("average_order_value_minor")

  // ── Tender totals (class A, PARTIAL — two tenders only, RPT-R2 cl. 8) ────
  cashAmountTotalMinor              BigInt @map("cash_amount_total_minor")
  cashRoundingAdjustmentTotalMinor  BigInt @map("cash_rounding_adjustment_total_minor")
  cashPaymentCount                  Int    @map("cash_payment_count")
  cardAmountTotalMinor              BigInt @map("card_amount_total_minor")
  cardPaymentCount                  Int    @map("card_payment_count")

  // ── Reconciliation (acceptance-correction identity terms) ────────────────
  unsettledCapturedTotalMinor        BigInt @map("unsettled_captured_total_minor")
  completedExcessCapturedTotalMinor  BigInt @map("completed_excess_captured_total_minor")

  // ── Void and comp summary (class C void / structurally-zero comp) ────────
  voidedLineCount      Int    @map("voided_line_count")
  voidedLineValueMinor BigInt @map("voided_line_value_minor")
  /// Structurally `0` — no code path writes `state:'comped'` (§9 CHECK).
  compLineCount        Int    @default(0) @map("comp_line_count")
  /// Structurally `0` (§9 CHECK).
  compLineValueMinor   BigInt @default(0) @map("comp_line_value_minor")

  // ── Cash reconciliation / variance summary (DC-R2 ownership) ─────────────
  /// Count of `day_close_sessions` linkage rows for this DayClose (day-scoped
  /// tender contribution OR variance ownership OR both).
  sessionCount             Int    @map("session_count")
  /// Count of linked sessions that OWN this day's variance
  /// (`closedBusinessDay == businessDay`) — DC-R2.
  varianceOwnerSessionCount Int   @map("variance_owner_session_count")
  /// `Σ variance OVER linkage rows WHERE isVarianceOwner` — counted exactly
  /// once system-wide (DC-R2 clause 2). WHOLE_SESSION scope; never a
  /// day-scoped figure.
  varianceTotalMinor        BigInt @map("variance_total_minor")

  createdAt DateTime @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  closedByUser     User                 @relation(fields: [closedBy], references: [id], onDelete: Restrict)
  closedByEmployee Employee?            @relation(fields: [tenantId, closedByEmployeeId], references: [tenantId, id], onDelete: Restrict)
  taxClassTotals   DayCloseTaxClassTotal[]
  orderTypeTotals  DayCloseOrderTypeTotal[]
  sessions         DayCloseSession[]

  @@unique([tenantId, id])
  /// One close per branch-day — the TERMINAL conflict (§14/§18 of the
  /// final design gate; "the day is genuinely already closed").
  @@unique([tenantId, branchId, businessDay], map: "uq_day_closes_branch_business_day")
  /// FR-FIN-023's structural backstop — the RETRYABLE conflict (a transient
  /// allocation collision handled by a local bounded retry, never a 409).
  @@unique([tenantId, branchId, zNumber], map: "uq_day_closes_branch_z_number")
  @@map("day_closes")
  @@schema("treasury")
}

/// Per-`tax_class_id` repeating group (FR-FIN-022 tax total — by CLASS,
/// never by rate, §9 of the final design gate). `taxClassId` carries no FK,
/// mirroring `sales.order_lines.tax_class_id`'s own FK-less design.
model DayCloseTaxClassTotal {
  id            String @id @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  dayCloseId    String @map("day_close_id") @db.Uuid
  taxClassId    String @map("tax_class_id") @db.Uuid
  taxAmountMinor   BigInt @map("tax_amount_minor")
  netAmountMinor   BigInt @map("net_amount_minor")
  grossAmountMinor BigInt @map("gross_amount_minor")
  lineCount        Int    @map("line_count")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayClose DayClose @relation(fields: [tenantId, dayCloseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, dayCloseId, taxClassId], map: "uq_dctc_day_close_tax_class")
  @@map("day_close_tax_class_totals")
  @@schema("treasury")
}

/// Per-`order_type` repeating group (FR-FIN-022 sales by order type, class
/// C — an immutable `NOT NULL` enum on the order itself, no master-data
/// join). Stored as TEXT with a CHECK against `sales.OrderType`'s values —
/// Treasury does not own that enum type and does not cross-reference it.
model DayCloseOrderTypeTotal {
  id           String @id @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  dayCloseId   String @map("day_close_id") @db.Uuid
  orderType    String @map("order_type") @db.VarChar(16)
  grossSalesMinor BigInt @map("gross_sales_minor")
  netSalesMinor   BigInt @map("net_sales_minor")
  orderCount      Int    @map("order_count")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayClose DayClose @relation(fields: [tenantId, dayCloseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, dayCloseId, orderType], map: "uq_dcot_day_close_order_type")
  @@map("day_close_order_type_totals")
  @@schema("treasury")
}

/// DC-R2's LINKAGE child — "which sessions did this Z's snapshot list".
/// One row per session PER DayClose (a spanning session MAY appear under
/// TWO DayClose rows — UNCONDITIONAL `UNIQUE(tenant, cashSessionId)` is
/// FORBIDDEN, DC-R2 clause 6). `isVarianceOwner` is a MATERIALISED,
/// defence-in-depth-only flag: true ownership is the THEOREM
/// `session.closedBusinessDay == dayClose.businessDay` (design-gate
/// acceptance correction §4.4) — this column and its partial unique index
/// exist only so a materialisation bug becomes a write failure, never a
/// silently double-counted variance.
model DayCloseSession {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  dayCloseId     String  @map("day_close_id") @db.Uuid
  cashSessionId  String  @map("cash_session_id") @db.Uuid
  isVarianceOwner Boolean @map("is_variance_owner")

  // ── Day-scoped tender contribution — genuinely day-attributable, from
  //    the immutable `order_payments.business_day` (§9 anti-double-counting
  //    rule 3). Zero for a zero-payment/movement-only session.
  dayScopedCashSalesTotalMinor             BigInt @map("day_scoped_cash_sales_total_minor")
  dayScopedCashRoundingAdjustmentsMinor    BigInt @map("day_scoped_cash_rounding_adjustments_minor")
  dayScopedManualExternalCardTotalMinor    BigInt @map("day_scoped_manual_external_card_total_minor")
  dayScopedPaymentCount                    Int    @map("day_scoped_payment_count")
  /// `COUNT(DISTINCT order_payments.business_day)` over ALL of this
  /// session's payments (not scoped to this DayClose's day) — the accepted
  /// Reporting `businessDayCount` precedent, so a sealed Z visibly declares
  /// a session that was not exclusive to it.
  businessDayCount                         Int    @map("business_day_count")

  // ── WHOLE_SESSION close facts — NEVER a day total (§9 rule 1). Snapshot
  //    of `cash_sessions`' own immutable close-facts row, identical on
  //    every linkage row for this session regardless of which day links it.
  wholeSessionOpeningFloatMinor  BigInt @map("whole_session_opening_float_minor")
  wholeSessionExpectedCashMinor  BigInt @map("whole_session_expected_cash_minor")
  wholeSessionCountedCashMinor   BigInt @map("whole_session_counted_cash_minor")
  wholeSessionVarianceMinor      BigInt @map("whole_session_variance_minor")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayClose    DayClose    @relation(fields: [tenantId, dayCloseId], references: [tenantId, id], onDelete: Restrict)
  cashSession CashSession @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  /// One row per session PER DayClose (linkage cardinality, DC-R2 clause 5).
  @@unique([tenantId, dayCloseId, cashSessionId], map: "uq_dcs_day_close_cash_session")
  @@map("day_close_sessions")
  @@schema("treasury")
}

// ---------------------------------------------------------------------------
// P15-2 — org.locations: the unified location registry.
//
// Required by the frozen Inventory Design Gate (blocker C-02, Decision A).
// Inventory's ledger, batches, levels, counts and waste all key on a location
// that may be a Branch, a Warehouse or a Central Kitchen. Those are three
// separate Phase 15 tables, so Inventory needs ONE non-null, FK-able location
// identity — `stock_levels` has PRIMARY KEY (stock_item_id, location_id), and
// PostgreSQL forbids nullable primary-key columns, so a nullable typed triple
// could not have served.
//
// This is a REGISTRY / REFERENCE layer, not a replacement: Branch, Warehouse and
// CentralKitchen remain authoritative for their own domain data. A location row
// carries no domain attributes of its own.
//
// Tenant safety is structural (ADR 0008 D-09): three real composite FKs plus a
// CHECK that enforces XOR across the typed columns AND agreement with
// location_type AND that ref_id equals whichever typed column is set.
// ---------------------------------------------------------------------------

enum LocationType {
  branch
  warehouse
  central_kitchen

  @@schema("org")
}

model Location {
  id           String       @id @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  locationType LocationType @map("location_type")
  /// Denormalised copy of whichever typed column below is set. Kept in step by
  /// the ck_location_target CHECK, so it can never disagree.
  refId        String       @map("ref_id") @db.Uuid

  /// Exactly one of the three is non-null, agreeing with locationType.
  branchId         String? @map("branch_id") @db.Uuid
  warehouseId      String? @map("warehouse_id") @db.Uuid
  centralKitchenId String? @map("central_kitchen_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                Tenant                      @relation(fields: [tenantId], references: [id])
  branch                Branch?                     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  // Inventory back-relations (Prisma requires both sides). No column added.
  stockBatches          StockBatch[]
  stockMovements        StockMovement[]
  stockLevels           StockLevel[]
  stockLevelBatchAllocs StockLevelBatchAllocation[]
  countSessions         CountSession[]
  wasteRecords          WasteRecord[]
  reorderConfigs        StockItemReorderConfig[]
  warehouse             Warehouse?                  @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Cascade)
  centralKitchen        CentralKitchen?             @relation(fields: [tenantId, centralKitchenId], references: [tenantId, id], onDelete: Cascade)
  // P1F-2 back-relation only (virtual; no DDL impact).
  saleDepletionEffects  SaleDepletionEffect[]

  /// Composite-FK target for Inventory: (tenant_id, location_id).
  @@unique([tenantId, id])
  /// One registry row per concrete org entity.
  @@unique([tenantId, locationType, refId])
  @@index([tenantId])
  @@map("locations")
  @@schema("org")
}

// ---------------------------------------------------------------------------
// INVENTORY bounded context — "what physically exists, where, and what it cost."
//
// Ratified design: D-INV-01 … D-INV-09 plus B-1 (composite last_movement FK) and
// B-2 (caller-supplied approval gate).
//
// Ubiquitous language (SRS §5.3): "Item" here means STOCKABLE. In Catalogue it
// means sellable. No Catalogue entity is copied or modified.
//
// Locations: every location-bearing table references org.locations through the
// tenant-safe composite key (tenant_id, location_id) — D-INV-02. No typed
// nullable triples, no bare UUIDs, no service-only validation.
// ---------------------------------------------------------------------------

/// FR-INV-012: valuation method. Independent of batch selection (D-INV-03).
enum CostingMethod {
  weighted_average
  fifo
  standard

  @@schema("inventory")
}

/// FR-INV-022/023: which eligible batch is consumed. FEFO is the SRS-required
/// default where expiry tracking is enabled. This determines SELECTION only —
/// valuation is `CostingMethod`. No costing semantics are inferred from it.
enum BatchStrategy {
  fifo
  fefo

  @@schema("inventory")
}

/// FR-INV-040 scope modes. No storage-area entity exists (D-INV-05).
enum CountScope {
  full_location
  category
  item_list

  @@schema("inventory")
}

enum CountSessionStatus {
  in_progress
  posted
  cancelled

  @@schema("inventory")
}

/// SRS §7.4.3 movement types, verbatim. Only 7 have a writer in this phase —
/// purchase_*, sale_*, production_* belong to Procurement, Sales and
/// Production/Central Kitchen respectively.
enum MovementType {
  purchase_receipt
  purchase_return
  sale_depletion
  sale_reversal
  transfer_out
  transfer_in
  production_input
  production_output
  waste
  count_adjustment
  manual_adjustment
  opening_balance
  expiry_writeoff

  @@schema("inventory")
}

/// Global, un-tenanted platform reference data (approved SQL). Not RLS-scoped,
/// like identity.permissions (ADR 0003 "Excluded tables").
model Uom {
  id                  String  @id @db.Uuid
  dimension           String  @db.VarChar(16)
  code                String  @unique @db.VarChar(16)
  name                String  @db.VarChar(64)
  baseUnitOfDimension Boolean @default(false) @map("base_unit_of_dimension")

  conversionsFrom UomConversion[] @relation("ConversionFrom")
  conversionsTo   UomConversion[] @relation("ConversionTo")
  baseForItems    StockItem[]     @relation("StockItemBaseUnit")
  recipeForItems  StockItem[]     @relation("StockItemRecipeUnit")
  movements       StockMovement[]

  // Production Spec back-relations (virtual; no DDL impact).
  recipeVersionYields RecipeVersion[] @relation("RecipeVersionYieldUnit")
  recipeLineUnits     RecipeLine[]    @relation("RecipeLineUnit")

  // P1F-2 back-relations (virtual; no DDL impact).
  modifierRecipeEffectUnits             ModifierRecipeEffect[]         @relation("ModifierRecipeEffectUnit")
  orderLineModifierEffectUnits          OrderLineModifierEffect[]      @relation("OrderLineModifierEffectUnit")
  orderLineComponentConversionFromUnits OrderLineComponentConversion[] @relation("OrderLineComponentConversionFromUnit")
  orderLineComponentConversionBaseUnits OrderLineComponentConversion[] @relation("OrderLineComponentConversionBaseUnit")
  saleDepletionEffectUnits              SaleDepletionEffect[]          @relation("SaleDepletionEffectUnit")
  saleDepletionAllocationUnits          SaleDepletionAllocation[]      @relation("SaleDepletionAllocationUnit")

  @@map("uom")
  @@schema("inventory")
}

/// BR-CORE-004: mass<->volume requires an item-specific density factor and must
/// FAIL where none is configured. `stockItemId` NULL = generic conversion.
model UomConversion {
  id          String  @id @db.Uuid
  fromUnitId  String  @map("from_unit_id") @db.Uuid
  toUnitId    String  @map("to_unit_id") @db.Uuid
  factor      Decimal @db.Decimal(20, 10)
  stockItemId String? @map("stock_item_id") @db.Uuid

  fromUnit  Uom        @relation("ConversionFrom", fields: [fromUnitId], references: [id])
  toUnit    Uom        @relation("ConversionTo", fields: [toUnitId], references: [id])
  stockItem StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId, stockItemId], map: "uq_uom_conv")
  @@map("uom_conversions")
  @@schema("inventory")
}

/// FR-INV-003: multiple purchase units per item. `supplierId` is a recorded UUID
/// with no FK — Procurement is out of scope.
model PackagingUnit {
  id                     String  @id @db.Uuid
  stockItemId            String  @map("stock_item_id") @db.Uuid
  supplierId             String? @map("supplier_id") @db.Uuid
  name                   String  @db.VarChar(64)
  conversionFactorToBase Decimal @map("conversion_factor_to_base") @db.Decimal(20, 6)

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@map("packaging_units")
  @@schema("inventory")
}

/// FR-INV-001: hierarchical category (Food > Protein > Poultry).
model StockItemCategory {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String  @db.VarChar(120)

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  parent   StockItemCategory?  @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id])
  children StockItemCategory[] @relation("CategoryTree")

  stockItems    StockItem[]
  countSessions CountSession[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("stock_item_categories")
  @@schema("inventory")
}

/// StockItem — SRS §7.3 #12. Exactly one base unit; base unit is immutable once
/// any movement exists (FR-INV-002, service-enforced).
///
/// D-INV-04: `expiryTracked` and `shelfLifeDays` are added because FR-INV-021
/// and FR-INV-023 cannot operate without them. `reorderPoint`/`reorderQuantity`
/// are deliberately ABSENT — FR-INV-065 [M] requires them per LOCATION, so they
/// live in StockItemReorderConfig.
model StockItem {
  id                  String        @id @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  sku                 String        @db.VarChar(32)
  names               Json          @db.JsonB
  categoryId          String?       @map("category_id") @db.Uuid
  baseUnitId          String        @map("base_unit_id") @db.Uuid
  recipeUnitId        String?       @map("recipe_unit_id") @db.Uuid
  costingMethod       CostingMethod @default(weighted_average) @map("costing_method")
  standardCost        BigInt?       @map("standard_cost")
  isBatchTracked      Boolean       @default(true) @map("is_batch_tracked")
  /// D-INV-04 / FR-INV-023: enables FEFO defaulting and expiry handling.
  expiryTracked       Boolean       @default(false) @map("expiry_tracked")
  /// D-INV-04 / FR-INV-021: default expiry = production_date + shelf_life_days.
  shelfLifeDays       Int?          @map("shelf_life_days")
  /// Batch SELECTION strategy only — never a costing input (D-INV-03).
  batchStrategy       BatchStrategy @default(fifo) @map("batch_strategy")
  storageRequirements Json?         @map("storage_requirements") @db.JsonB
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  category   StockItemCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  baseUnit   Uom                @relation("StockItemBaseUnit", fields: [baseUnitId], references: [id])
  recipeUnit Uom?               @relation("StockItemRecipeUnit", fields: [recipeUnitId], references: [id])

  conversions    UomConversion[]
  packagingUnits PackagingUnit[]
  reorderConfigs StockItemReorderConfig[]
  batches        StockBatch[]
  movements      StockMovement[]
  levels         StockLevel[]
  levelAllocs    StockLevelBatchAllocation[]
  countLines     CountLine[]
  countItems     CountSessionItem[]
  wasteLines     WasteLine[]

  // Production Spec back-relations (virtual; no DDL impact).
  recipeTargets          Recipe[]                @relation("RecipeTargetStockItem")
  recipeLines            RecipeLine[]            @relation("RecipeLineStockItem")
  substituteGroupMembers SubstituteGroupMember[] @relation("SubstituteGroupMemberStockItem")

  // P1F-2 back-relations (virtual; no DDL impact).
  modifierRecipeEffects         ModifierRecipeEffect[]         @relation("ModifierRecipeEffectStockItem")
  orderLineModifierEffectPins   OrderLineModifierEffect[]      @relation("OrderLineModifierEffectStockItem")
  orderLineComponentConversions OrderLineComponentConversion[] @relation("OrderLineComponentConversionStockItem")
  saleDepletionEffects          SaleDepletionEffect[]          @relation("SaleDepletionEffectStockItem")

  @@unique([tenantId, id])
  @@unique([tenantId, sku], map: "uq_stock_item_sku")
  @@index([tenantId])
  @@map("stock_items")
  @@schema("inventory")
}

/// D-INV-04 / FR-INV-065 [M]: reorder configuration is PER LOCATION, resolving
/// the approved SQL's tenant-wide item attributes.
model StockItemReorderConfig {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  stockItemId     String   @map("stock_item_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  reorderPoint    Decimal? @map("reorder_point") @db.Decimal(18, 6)
  reorderQuantity Decimal? @map("reorder_quantity") @db.Decimal(18, 6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockItem StockItem @relation(fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Cascade)
  location  Location  @relation(fields: [tenantId, locationId], references: [tenantId, id])

  @@unique([tenantId, stockItemId, locationId])
  @@index([tenantId, locationId])
  @@map("stock_item_reorder_configs")
  @@schema("inventory")
}

/// Batch — SRS §7.3 #14. Expiry >= production date; quantity >= 0 (DB CHECKs).
/// `supplierId` / `goodsReceiptId` are recorded UUIDs — Procurement is out of scope.
model StockBatch {
  id                       String    @id @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  stockItemId              String    @map("stock_item_id") @db.Uuid
  locationId               String    @map("location_id") @db.Uuid
  batchNumber              String?   @map("batch_number") @db.VarChar(64)
  productionDate           DateTime? @map("production_date") @db.Date
  expiryDate               DateTime? @map("expiry_date") @db.Date
  quantityReceived         Decimal   @map("quantity_received") @db.Decimal(18, 6)
  quantityRemaining        Decimal   @map("quantity_remaining") @db.Decimal(18, 6)
  unitCost                 BigInt    @map("unit_cost")
  supplierId               String?   @map("supplier_id") @db.Uuid
  goodsReceiptId           String?   @map("goods_receipt_id") @db.Uuid
  /// P1F-2 — the RECEIPT-ORDER FIFO ACCOUNTING axis, independent of the
  /// physical `quantityRemaining` axis (P1F2E-A CONTROLLING). "consumed" not
  /// "remaining" so DEFAULT 0 gives new batches full cost quantity with no
  /// batch-creation writer changed. Cost-remaining is DERIVED:
  /// `quantityReceived - fifoCostQuantityConsumed`. Maintained ONLY by the
  /// private `inventory/costing/fifo-cost-ledger.ts` kernel, for
  /// costing_method=fifo batch-tracked items; stays 0 for every other item.
  fifoCostQuantityConsumed Decimal   @default(0) @map("fifo_cost_quantity_consumed") @db.Decimal(18, 6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockItem StockItem @relation(fields: [tenantId, stockItemId], references: [tenantId, id])
  location  Location  @relation(fields: [tenantId, locationId], references: [tenantId, id])

  movements                           StockMovement[]
  levelAllocs                         StockLevelBatchAllocation[]
  countLines                          CountLine[]
  wasteLines                          WasteLine[]
  // P1F-2 back-relations (virtual; no DDL impact).
  saleDepletionAllocationsAsPhysical  SaleDepletionAllocation[]   @relation("SaleDepletionAllocationPhysicalBatch")
  saleDepletionAllocationsAsCostBasis SaleDepletionAllocation[]   @relation("SaleDepletionAllocationCostBasisBatch")

  @@unique([tenantId, id])
  /// P1F-2 (P1F2E-A §G) — additive, proves an allocation's physical/cost-basis
  /// batch belongs to the SAME stock item and location as its parent effect.
  /// No column added, no semantics changed (D-16 precedent).
  @@unique([tenantId, id, stockItemId, locationId], map: "stock_batches_tenant_id_id_item_location_key")
  @@index([tenantId, stockItemId, locationId])
  @@index([tenantId, expiryDate])
  @@map("stock_batches")
  @@schema("inventory")
}

/// StockMovement — SRS §7.3 #15 / §7.4.3. The immutable append-only ledger.
///
/// D-INV-01: RANGE-partitioned by `occurredAt`. PostgreSQL requires every unique
/// constraint on a partitioned table to include the partition key, so the PK is
/// (id, occurredAt) — `PRIMARY KEY (id)` is rejected outright. Both references
/// into this table are therefore composite:
///   * counterpart (BR-INV-002 transfer pairing)
///   * StockLevel.lastMovement (B-1)
/// Append-only is enforced at the DATABASE via REVOKE UPDATE/DELETE plus the
/// absence of any update/delete policy (BR-INV-001, ADR 0007 pattern).
model StockMovement {
  id                    String       @db.Uuid
  occurredAt            DateTime     @map("occurred_at") @db.Timestamptz(6)
  tenantId              String       @map("tenant_id") @db.Uuid
  locationId            String       @map("location_id") @db.Uuid
  stockItemId           String       @map("stock_item_id") @db.Uuid
  batchId               String?      @map("batch_id") @db.Uuid
  movementType          MovementType @map("movement_type")
  /// Signed: negative = out.
  quantity              Decimal      @db.Decimal(18, 6)
  unitId                String       @map("unit_id") @db.Uuid
  unitCost              BigInt       @map("unit_cost")
  totalCost             BigInt       @map("total_cost")
  balanceAfter          Decimal      @map("balance_after") @db.Decimal(18, 6)
  referenceType         String       @map("reference_type") @db.VarChar(32)
  referenceId           String       @map("reference_id") @db.Uuid
  counterpartMovementId String?      @map("counterpart_movement_id") @db.Uuid
  counterpartOccurredAt DateTime?    @map("counterpart_occurred_at") @db.Timestamptz(6)
  recordedAt            DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  performedBy           String       @map("performed_by") @db.Uuid
  reasonCodeId          String?      @map("reason_code_id") @db.Uuid
  notes                 String?

  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  location        Location    @relation(fields: [tenantId, locationId], references: [tenantId, id])
  stockItem       StockItem   @relation(fields: [tenantId, stockItemId], references: [tenantId, id])
  batch           StockBatch? @relation(fields: [tenantId, batchId], references: [tenantId, id])
  reasonCode      ReasonCode? @relation(fields: [tenantId, reasonCodeId], references: [tenantId, id])
  unit            Uom         @relation(fields: [unitId], references: [id])
  performedByUser User        @relation(fields: [performedBy], references: [id])

  counterpart              StockMovement?            @relation("MovementCounterpart", fields: [tenantId, counterpartMovementId, counterpartOccurredAt], references: [tenantId, id, occurredAt])
  counterpartOf            StockMovement[]           @relation("MovementCounterpart")
  lastOfLevels             StockLevel[]              @relation("StockLevelLastMovement")
  // P1F-2 back-relation only (virtual; no DDL impact).
  saleDepletionAllocations SaleDepletionAllocation[]

  @@id([id, occurredAt])
  @@unique([tenantId, id, occurredAt])
  @@index([stockItemId, locationId, occurredAt(sort: Desc)], map: "idx_mv_item_loc_time")
  @@index([referenceType, referenceId], map: "idx_mv_reference")
  @@index([tenantId, occurredAt])
  @@map("stock_movements")
  @@schema("inventory")
}

/// StockLevel — SRS §7.3 #13. A PROJECTION over the ledger, never authored
/// directly; reconcilable to movements (BR-INV-003).
/// D-INV-09: carries tenant_id as the RLS anchor and NFR-PERF-005 index prefix.
/// B-1: lastMovement is a COMPOSITE FK into the partitioned ledger.
model StockLevel {
  tenantId               String    @map("tenant_id") @db.Uuid
  stockItemId            String    @map("stock_item_id") @db.Uuid
  locationId             String    @map("location_id") @db.Uuid
  quantityOnHand         Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(18, 6)
  /// Allocated to open orders/production. No writer exists in this phase.
  quantityReserved       Decimal   @default(0) @map("quantity_reserved") @db.Decimal(18, 6)
  averageCost            BigInt    @default(0) @map("average_cost")
  lastMovementId         String?   @map("last_movement_id") @db.Uuid
  lastMovementOccurredAt DateTime? @map("last_movement_occurred_at") @db.Timestamptz(6)
  lastReconciledAt       DateTime? @map("last_reconciled_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  stockItem    StockItem      @relation(fields: [tenantId, stockItemId], references: [tenantId, id])
  location     Location       @relation(fields: [tenantId, locationId], references: [tenantId, id])
  lastMovement StockMovement? @relation("StockLevelLastMovement", fields: [tenantId, lastMovementId, lastMovementOccurredAt], references: [tenantId, id, occurredAt])

  @@id([stockItemId, locationId])
  @@unique([tenantId, stockItemId, locationId])
  @@index([tenantId, locationId, stockItemId])
  @@map("stock_levels")
  @@schema("inventory")
}

model StockLevelBatchAllocation {
  tenantId          String  @map("tenant_id") @db.Uuid
  stockItemId       String  @map("stock_item_id") @db.Uuid
  locationId        String  @map("location_id") @db.Uuid
  batchId           String  @map("batch_id") @db.Uuid
  quantityAllocated Decimal @map("quantity_allocated") @db.Decimal(18, 6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  stockItem StockItem  @relation(fields: [tenantId, stockItemId], references: [tenantId, id])
  location  Location   @relation(fields: [tenantId, locationId], references: [tenantId, id])
  batch     StockBatch @relation(fields: [tenantId, batchId], references: [tenantId, id])

  @@id([stockItemId, locationId, batchId])
  @@index([tenantId, batchId])
  @@map("stock_level_batch_allocations")
  @@schema("inventory")
}

/// CountSession — SRS §7.3 #16. Cannot post twice; blind count locks expected qty.
/// D-INV-05: scope covers full location, category and ad-hoc item list. No
/// storage-area entity.
model CountSession {
  id               String             @id @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  locationId       String             @map("location_id") @db.Uuid
  scopeType        CountScope         @default(full_location) @map("scope_type")
  /// Category id when scopeType = category; NULL otherwise (typed, not polymorphic).
  scopeId          String?            @map("scope_id") @db.Uuid
  status           CountSessionStatus @default(in_progress)
  /// FR-INV-042: blind is the SRS default and hides expected quantity.
  isBlindCount     Boolean            @default(true) @map("is_blind_count")
  startedBy        String             @map("started_by") @db.Uuid
  startedAt        DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  postedAt         DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedBy         String?            @map("posted_by") @db.Uuid
  /// B-2: caller-supplied approval gate. TRUE blocks posting until Governance
  /// exists. Inventory NEVER evaluates a threshold.
  requiresApproval Boolean            @default(false) @map("requires_approval")

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  location      Location           @relation(fields: [tenantId, locationId], references: [tenantId, id])
  scopeCategory StockItemCategory? @relation(fields: [tenantId, scopeId], references: [tenantId, id])
  starter       User               @relation("CountStartedBy", fields: [startedBy], references: [id])
  poster        User?              @relation("CountPostedBy", fields: [postedBy], references: [id])

  items CountSessionItem[]
  lines CountLine[]

  @@unique([tenantId, id])
  @@index([tenantId, locationId])
  @@map("count_sessions")
  @@schema("inventory")
}

/// D-INV-05: the ad-hoc item list for scopeType = item_list. A child of the
/// session inside Inventory — no new bounded context.
model CountSessionItem {
  id             String @id @db.Uuid
  countSessionId String @map("count_session_id") @db.Uuid
  stockItemId    String @map("stock_item_id") @db.Uuid

  session   CountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  stockItem StockItem    @relation(fields: [stockItemId], references: [id])

  @@unique([countSessionId, stockItemId])
  @@map("count_session_items")
  @@schema("inventory")
}

/// FR-INV-044: expectedQuantity is FROZEN at session open.
model CountLine {
  id               String   @id @db.Uuid
  countSessionId   String   @map("count_session_id") @db.Uuid
  stockItemId      String   @map("stock_item_id") @db.Uuid
  batchId          String?  @map("batch_id") @db.Uuid
  expectedQuantity Decimal? @map("expected_quantity") @db.Decimal(18, 6)
  countedQuantity  Decimal? @map("counted_quantity") @db.Decimal(18, 6)
  variance         Decimal? @db.Decimal(18, 6)
  recountOfLineId  String?  @map("recount_of_line_id") @db.Uuid

  session   CountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  stockItem StockItem    @relation(fields: [stockItemId], references: [id])
  batch     StockBatch?  @relation(fields: [batchId], references: [id])
  recountOf CountLine?   @relation("CountRecount", fields: [recountOfLineId], references: [id])
  recounts  CountLine[]  @relation("CountRecount")

  @@index([countSessionId])
  @@map("count_lines")
  @@schema("inventory")
}

/// FR-INV-057: configurable reason taxonomy. D-INV-09: natural key on
/// (tenant_id, category, code).
model ReasonCode {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// waste | adjustment (approved SQL comment).
  category String @db.VarChar(16)
  code     String @db.VarChar(32)
  label    Json   @db.JsonB

  tenant Tenant @relation(fields: [tenantId], references: [id])

  wasteRecords WasteRecord[]
  movements    StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, category, code], map: "uq_reason_code")
  @@index([tenantId])
  @@map("reason_codes")
  @@schema("inventory")
}

/// FR-INV-056. B-2: `requiresApproval` is caller-supplied; when true, posting is
/// REFUSED because no approved Governance request can exist yet.
/// `approvalRequestId` is a recorded UUID and remains NULL in this phase —
/// governance.approval_requests does not exist and is NOT created here.
model WasteRecord {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  reasonCodeId      String   @map("reason_code_id") @db.Uuid
  totalValue        BigInt   @map("total_value")
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  approvalRequestId String?  @map("approval_request_id") @db.Uuid
  recordedBy        String   @map("recorded_by") @db.Uuid
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  location   Location   @relation(fields: [tenantId, locationId], references: [tenantId, id])
  reasonCode ReasonCode @relation(fields: [tenantId, reasonCodeId], references: [tenantId, id])
  recorder   User       @relation(fields: [recordedBy], references: [id])

  lines WasteLine[]

  @@unique([tenantId, id])
  @@index([tenantId, locationId])
  @@map("waste_records")
  @@schema("inventory")
}

model WasteLine {
  id            String  @id @db.Uuid
  wasteRecordId String  @map("waste_record_id") @db.Uuid
  stockItemId   String  @map("stock_item_id") @db.Uuid
  batchId       String? @map("batch_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 6)
  unitCost      BigInt  @map("unit_cost")

  wasteRecord WasteRecord @relation(fields: [wasteRecordId], references: [id], onDelete: Cascade)
  stockItem   StockItem   @relation(fields: [stockItemId], references: [id])
  batch       StockBatch? @relation(fields: [batchId], references: [id])

  @@index([wasteRecordId])
  @@map("waste_lines")
  @@schema("inventory")
}

// ---------------------------------------------------------------------------
// Production Spec — Recipe bounded context (SRS §7.4.4, §10.6).
// Frozen design: docs/production/PRODUCTION_SPEC_DESIGN_GATE.md
//
// D-17-02  polymorphic refs = typed nullable columns + composite FKs + XOR
// D-17-03  scope tenant|brand|branch, precedence branch > brand > tenant
// D-17-04  published versions immutable; lifecycle draft -> published ->
//          superseded; `archived` deliberately absent from the enum
// D-17-05  costing deferred; computed_cost / cost_computed_at never written
// D-17-06  exactly recipe.view / recipe.edit / recipe.publish
// D-17-07  modifiers.recipe_delta stays opaque
// D-17-08  ONE published version per recipe (partial unique index);
//          `effective_from` is INFORMATIONAL ONLY and never selects a version
// ---------------------------------------------------------------------------

enum RecipeScope {
  tenant
  brand
  branch

  @@schema("production")
}

enum RecipeType {
  menu_item
  sub_recipe
  production_item

  @@schema("production")
}

/// D-17-04: `archived` is intentionally NOT a member. The SRS names it in the
/// §7.4.4 enum listing but defines no semantics or legal transition for it, so
/// the value is unrepresentable rather than merely unused.
enum RecipeVersionStatus {
  draft
  published
  superseded

  @@schema("production")
}

enum RecipeComponentType {
  stock_item
  sub_recipe

  @@schema("production")
}

/// Logical recipe identity, stable across versions (SRS §7.4.4).
/// `scope_id` and `target_id` from the approved SQL are decomposed into typed
/// nullable columns with composite tenant-safe FKs and XOR CHECKs (D-17-02).
model Recipe {
  id                String      @id @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  scope             RecipeScope
  /// D-17-03: exactly one of these is populated for brand/branch scope; both
  /// are NULL for tenant scope. Enforced by ck_recipe_scope.
  brandId           String?     @map("brand_id") @db.Uuid
  branchId          String?     @map("branch_id") @db.Uuid
  recipeType        RecipeType  @map("recipe_type")
  /// §7.4.4 target_id = "MenuItemVariant or StockItem produced".
  /// menu_item -> variant; sub_recipe / production_item -> stock item.
  /// Enforced by ck_recipe_target.
  menuItemVariantId String?     @map("menu_item_variant_id") @db.Uuid
  stockItemId       String?     @map("stock_item_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  brand           Brand?           @relation(fields: [tenantId, brandId], references: [tenantId, id])
  branch          Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  menuItemVariant MenuItemVariant? @relation(fields: [tenantId, menuItemVariantId], references: [tenantId, id])
  stockItem       StockItem?       @relation("RecipeTargetStockItem", fields: [tenantId, stockItemId], references: [tenantId, id])

  versions                      RecipeVersion[]
  usedAsComponent               RecipeLine[]           @relation("RecipeLineSubRecipe")
  // P1F-2 back-relation only (virtual; no DDL impact on this model).
  usedAsModifierEffectSubRecipe ModifierRecipeEffect[] @relation("ModifierRecipeEffectSubRecipe")

  // D-09 composite-FK target for recipe_versions and recipe_lines.sub_recipe_id.
  @@unique([tenantId, id])
  @@index([tenantId, scope])
  @@index([tenantId, recipeType])
  @@map("recipes")
  @@schema("production")
}

model RecipeVersion {
  id       String              @id @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  recipeId String              @map("recipe_id") @db.Uuid
  /// §7.4.4 "Incremented on publish". NOT NULL and unique per recipe, so a
  /// value must exist at draft-insert time: assigned as max(version)+1.
  version  Int
  status   RecipeVersionStatus @default(draft)

  yieldQuantity   Decimal @map("yield_quantity") @db.Decimal(18, 6)
  yieldUnitId     String  @map("yield_unit_id") @db.Uuid
  yieldPercentage Decimal @default(100.00) @map("yield_percentage") @db.Decimal(5, 2)
  prepTimeSeconds Int?    @map("prep_time_seconds")

  /// D-17-05: present per the approved SQL, NEVER written by this phase.
  computedCost   BigInt?   @map("computed_cost")
  costComputedAt DateTime? @map("cost_computed_at") @db.Timestamptz(6)

  /// D-17-08 Q2: INFORMATIONAL ONLY. Stored and returned; MUST NOT appear in
  /// any selection predicate, ORDER BY, publish path or resolver. There is no
  /// effective_to, no published_at and no priority column, by ratification.
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz(6)

  publishedBy     String?  @map("published_by") @db.Uuid
  instructions    Json?    @db.JsonB
  referenceImages Json?    @map("reference_images") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipe    Recipe @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Cascade)
  yieldUnit Uom    @relation("RecipeVersionYieldUnit", fields: [yieldUnitId], references: [id])
  publisher User?  @relation("RecipeVersionPublisher", fields: [publishedBy], references: [id])

  lines                       RecipeLine[]
  // P1F-2 back-relations only (virtual; no DDL impact on this model).
  orderLineRecipeVersionPins  OrderLineRecipeVersion[]  @relation("OrderLineRecipeVersionPin")
  orderLineModifierEffectPins OrderLineModifierEffect[] @relation("OrderLineModifierEffectSubRecipeVersion")

  @@unique([tenantId, id])
  @@unique([recipeId, version], map: "uq_recipe_version")
  @@index([tenantId, recipeId])
  @@map("recipe_versions")
  @@schema("production")
}

model RecipeLine {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  recipeVersionId String              @map("recipe_version_id") @db.Uuid
  sequence        Int                 @db.SmallInt
  componentType   RecipeComponentType @map("component_type")
  /// D-17-02 decomposition of component_id; XOR by ck_recipe_line_component.
  /// A sub-recipe component references LOGICAL RECIPE IDENTITY (FR-MNU-041,
  /// BR-MNU-001, §7.4.4 all say "recipe", never "recipe version").
  stockItemId     String?             @map("stock_item_id") @db.Uuid
  subRecipeId     String?             @map("sub_recipe_id") @db.Uuid

  /// §7.4.4 "Per recipe yield, not per portion".
  quantity          Decimal @db.Decimal(18, 6)
  unitId            String  @map("unit_id") @db.Uuid
  wastagePercentage Decimal @default(0) @map("wastage_percentage") @db.Decimal(5, 2)
  isOptional        Boolean @default(false) @map("is_optional")
  substituteGroupId String? @map("substitute_group_id") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  recipeVersion   RecipeVersion    @relation(fields: [tenantId, recipeVersionId], references: [tenantId, id], onDelete: Cascade)
  stockItem       StockItem?       @relation("RecipeLineStockItem", fields: [tenantId, stockItemId], references: [tenantId, id])
  subRecipe       Recipe?          @relation("RecipeLineSubRecipe", fields: [tenantId, subRecipeId], references: [tenantId, id])
  unit            Uom              @relation("RecipeLineUnit", fields: [unitId], references: [id])
  substituteGroup SubstituteGroup? @relation(fields: [tenantId, substituteGroupId], references: [tenantId, id])

  @@index([tenantId, recipeVersionId])
  @@index([tenantId, subRecipeId])
  @@map("recipe_lines")
  @@schema("production")
}

model SubstituteGroup {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(120)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  members     SubstituteGroupMember[]
  recipeLines RecipeLine[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("substitute_groups")
  @@schema("production")
}

model SubstituteGroupMember {
  tenantId          String @map("tenant_id") @db.Uuid
  substituteGroupId String @map("substitute_group_id") @db.Uuid
  stockItemId       String @map("stock_item_id") @db.Uuid

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  group     SubstituteGroup @relation(fields: [tenantId, substituteGroupId], references: [tenantId, id], onDelete: Cascade)
  stockItem StockItem       @relation("SubstituteGroupMemberStockItem", fields: [tenantId, stockItemId], references: [tenantId, id])

  @@id([substituteGroupId, stockItemId])
  @@index([tenantId])
  @@map("substitute_group_members")
  @@schema("production")
}

// ---------------------------------------------------------------------------
// P1F-2 — Final Payment + Order Completion atomic orchestration.
// Migration 28 (Sales) / 29 (Production) / 30 (Inventory). Authority:
// docs/reports/claude/2026-08-25_P1F2E-A_inventory-acceptance-correction.md
// (CONTROLLING) §L. See that report for the full rationale; this schema is a
// literal transcription of its exact DDL.
// ---------------------------------------------------------------------------

enum ModifierEffectOperationSnapshot {
  add
  remove_all

  @@schema("sales")
}

enum RecipeComponentTypeSnapshot {
  stock_item
  sub_recipe

  @@schema("sales")
}

/// LINE-CAPTURE snapshot — the pinned recipe-version CLOSURE (base version +
/// every sub-recipe version reachable from it) for one order line, at the
/// business day it was captured. NEVER updated after insert (append-only,
/// SELECT+INSERT only). Read only by `planConsumption` at Completion, which
/// resolves sub-recipes ONLY to the versions pinned here — never to whatever
/// is currently published.
model OrderLineRecipeVersion {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  businessDay     DateTime @map("business_day") @db.Date
  orderLineId     String   @map("order_line_id") @db.Uuid
  recipeVersionId String   @map("recipe_version_id") @db.Uuid
  /// 0 = the line's own base recipe version; >0 = a sub-recipe reached at
  /// that depth in the closure.
  depth           Int      @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderLine     OrderLine     @relation(fields: [tenantId, orderLineId, businessDay], references: [tenantId, id, businessDay], onDelete: Cascade)
  recipeVersion RecipeVersion @relation("OrderLineRecipeVersionPin", fields: [tenantId, recipeVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, orderLineId, businessDay, recipeVersionId])
  @@map("order_line_recipe_versions")
  @@schema("sales")
}

/// LINE-CAPTURE snapshot — the PINNED modifier effects selected on the line,
/// copied verbatim from `production.modifier_recipe_effects` at capture time.
/// A later edit to the source Modifier's recipe effects (via `PUT
/// /modifiers/{id}/recipe-effects`) never changes an already-captured line —
/// this row is what Completion reads instead. XOR shape and operation rules
/// mirror `production.modifier_recipe_effects` exactly (ck_ol_mod_effect_xor
/// / ck_ol_mod_effect_operation, migration 28).
model OrderLineModifierEffect {
  id                  String                          @id @db.Uuid
  tenantId            String                          @map("tenant_id") @db.Uuid
  businessDay         DateTime                        @map("business_day") @db.Date
  orderLineId         String                          @map("order_line_id") @db.Uuid
  orderLineModifierId String                          @map("order_line_modifier_id") @db.Uuid
  operation           ModifierEffectOperationSnapshot
  componentType       RecipeComponentTypeSnapshot     @map("component_type")
  stockItemId         String?                         @map("stock_item_id") @db.Uuid
  subRecipeVersionId  String?                         @map("sub_recipe_version_id") @db.Uuid
  /// DECIMAL(18,6); NULL for `remove_all`.
  quantity            Decimal?                        @db.Decimal(18, 6)
  unitId              String?                         @map("unit_id") @db.Uuid
  sequence            Int                             @db.SmallInt
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  orderLineModifier OrderLineModifier @relation(fields: [tenantId, orderLineModifierId], references: [tenantId, id], onDelete: Cascade)
  orderLine         OrderLine         @relation(fields: [tenantId, orderLineId, businessDay], references: [tenantId, id, businessDay], onDelete: Cascade)
  stockItem         StockItem?        @relation("OrderLineModifierEffectStockItem", fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)
  /// PINNED VERSION — never the logical recipe id (unlike
  /// `production.modifier_recipe_effects.sub_recipe_id`, which is logical).
  subRecipeVersion  RecipeVersion?    @relation("OrderLineModifierEffectSubRecipeVersion", fields: [tenantId, subRecipeVersionId], references: [tenantId, id], onDelete: Restrict)
  unit              Uom?              @relation("OrderLineModifierEffectUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderLineId, businessDay])
  @@map("order_line_modifier_effects")
  @@schema("sales")
}

/// LINE-CAPTURE snapshot — the pinned unit-conversion FACTOR from a
/// recipe/modifier component's line unit to the stock item's base unit, at
/// capture time. `planConsumption` at Completion takes conversion factors
/// ONLY from here — it must never read `inventory.uom_conversions` or
/// `stock_items.base_unit_id` directly, so a later change to either can never
/// alter an already-completed depletion.
model OrderLineComponentConversion {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  businessDay DateTime @map("business_day") @db.Date
  orderLineId String   @map("order_line_id") @db.Uuid
  stockItemId String   @map("stock_item_id") @db.Uuid
  fromUnitId  String   @map("from_unit_id") @db.Uuid
  baseUnitId  String   @map("base_unit_id") @db.Uuid
  factor      Decimal  @db.Decimal(20, 10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderLine OrderLine @relation(fields: [tenantId, orderLineId, businessDay], references: [tenantId, id, businessDay], onDelete: Cascade)
  stockItem StockItem @relation("OrderLineComponentConversionStockItem", fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)
  fromUnit  Uom       @relation("OrderLineComponentConversionFromUnit", fields: [fromUnitId], references: [id], onDelete: Restrict)
  baseUnit  Uom       @relation("OrderLineComponentConversionBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, orderLineId, stockItemId, fromUnitId])
  @@map("order_line_component_conversions")
  @@schema("sales")
}

enum ModifierEffectOperation {
  add
  remove_all

  @@schema("production")
}

/// D-17-07 resolution — a Modifier's effect on recipe consumption, replacing
/// the permanently-opaque `catalogue.modifiers.recipe_delta` (never read).
/// Full-replace via `PUT /modifiers/{modifierId}/recipe-effects`. Read by
/// Sales' `resolveConsumptionBasis` at LINE CAPTURE only — an edit here never
/// changes an already-captured line (see `sales.order_line_modifier_effects`).
model ModifierRecipeEffect {
  id            String                  @id @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  modifierId    String                  @map("modifier_id") @db.Uuid
  operation     ModifierEffectOperation
  /// Reuses the EXISTING `production.RecipeComponentType` enum.
  componentType RecipeComponentType     @map("component_type")
  stockItemId   String?                 @map("stock_item_id") @db.Uuid
  /// LOGICAL recipe identity (never a pinned version) — resolved to the
  /// published version at capture time, same as `recipe_lines.sub_recipe_id`.
  subRecipeId   String?                 @map("sub_recipe_id") @db.Uuid
  /// DECIMAL(18,6); NULL for `remove_all`.
  quantity      Decimal?                @db.Decimal(18, 6)
  unitId        String?                 @map("unit_id") @db.Uuid
  sequence      Int                     @db.SmallInt
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  modifier  Modifier   @relation(fields: [tenantId, modifierId], references: [tenantId, id], onDelete: Cascade)
  stockItem StockItem? @relation("ModifierRecipeEffectStockItem", fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)
  subRecipe Recipe?    @relation("ModifierRecipeEffectSubRecipe", fields: [tenantId, subRecipeId], references: [tenantId, id], onDelete: Restrict)
  unit      Uom?       @relation("ModifierRecipeEffectUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, modifierId])
  @@map("modifier_recipe_effects")
  @@schema("production")
}

/// Dual-axis depletion — PARENT / business identity. One row per (OrderLine,
/// StockItem, Location) touched by a completed sale. Reserved FIRST, before
/// any Inventory mutation (P1F2E-A §E) via `INSERT ... ON CONFLICT (tenant_id,
/// order_line_id, stock_item_id, location_id) DO NOTHING` — the row winning
/// that race is the ONLY writer allowed to touch batches/counters/levels/
/// movements for this (line, item, location). NO cost columns, NO movement
/// columns here — those live on the child `sale_depletion_allocations`.
model SaleDepletionEffect {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  businessDay        DateTime @map("business_day") @db.Date
  orderLineId        String   @map("order_line_id") @db.Uuid
  stockItemId        String   @map("stock_item_id") @db.Uuid
  locationId         String   @map("location_id") @db.Uuid
  quantityInBaseUnit Decimal  @map("quantity_in_base_unit") @db.Decimal(18, 6)
  unitId             String   @map("unit_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderLine   OrderLine                 @relation(fields: [tenantId, orderId, orderLineId, businessDay], references: [tenantId, orderId, id, businessDay], onDelete: Restrict)
  stockItem   StockItem                 @relation("SaleDepletionEffectStockItem", fields: [tenantId, stockItemId], references: [tenantId, id], onDelete: Restrict)
  location    Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  unit        Uom                       @relation("SaleDepletionEffectUnit", fields: [unitId], references: [id], onDelete: Restrict)
  allocations SaleDepletionAllocation[]

  /// Business identity — the reservation key (P1F2E-A §E).
  @@unique([tenantId, orderLineId, stockItemId, locationId])
  /// FK target for the child, proving the child's item/location ARE this
  /// effect's (P1F2E-A §G structural correction).
  @@unique([tenantId, id, stockItemId, locationId])
  @@map("sale_depletion_effects")
  @@schema("inventory")
}

/// Dual-axis depletion — CHILD. One row per (physical batch, cost layer)
/// slice the zipper (P1F2E-A §E step 3d) emitted for one effect. Carries a
/// deliberately-redundant `stockItemId`/`locationId` (copied from the parent)
/// solely so the composite structural FKs below can be expressed — P1F2E-A
/// §G. `physicalBatchId` NULL = unbacked (negative stock, FR-INV-014).
/// `costBasisBatchId` NULL only for weighted_average/standard; for
/// costing_method=fifo it is NEVER null, including for a carry-forward slice
/// (P1F2E-A §F) — the exhausted layer's id is retained even though
/// `physicalBatchId` is null there too.
model SaleDepletionAllocation {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  effectId           String   @map("effect_id") @db.Uuid
  sequence           Int      @db.SmallInt
  stockItemId        String   @map("stock_item_id") @db.Uuid
  locationId         String   @map("location_id") @db.Uuid
  physicalBatchId    String?  @map("physical_batch_id") @db.Uuid
  costBasisBatchId   String?  @map("cost_basis_batch_id") @db.Uuid
  quantityInBaseUnit Decimal  @map("quantity_in_base_unit") @db.Decimal(18, 6)
  unitId             String   @map("unit_id") @db.Uuid
  /// Minor units. The ACTUAL cost-basis unit cost — never a blended figure.
  unitCost           BigInt   @map("unit_cost")
  /// Minor units, POSITIVE magnitude (repo convention, costing.spec.ts:184-186
  /// deliberate §7.4.3 deviation) = round_half_up(quantity x unitCost).
  totalCost          BigInt   @map("total_cost")
  movementId         String   @map("movement_id") @db.Uuid
  movementOccurredAt DateTime @map("movement_occurred_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  effect         SaleDepletionEffect @relation(fields: [tenantId, effectId, stockItemId, locationId], references: [tenantId, id, stockItemId, locationId], onDelete: Restrict)
  physicalBatch  StockBatch?         @relation("SaleDepletionAllocationPhysicalBatch", fields: [tenantId, physicalBatchId, stockItemId, locationId], references: [tenantId, id, stockItemId, locationId], onDelete: Restrict)
  costBasisBatch StockBatch?         @relation("SaleDepletionAllocationCostBasisBatch", fields: [tenantId, costBasisBatchId, stockItemId, locationId], references: [tenantId, id, stockItemId, locationId], onDelete: Restrict)
  /// The movement THIS allocation produced (P1F2E-A §E step 3e-2). NOT
  /// structurally proven to bind the same item/location — that binding is
  /// service-enforced only (P1F2E-A §G; a 4th unique index on the
  /// RANGE-partitioned `stock_movements` was deliberately rejected).
  movement       StockMovement       @relation(fields: [tenantId, movementId, movementOccurredAt], references: [tenantId, id, occurredAt], onDelete: Restrict)
  unit           Uom                 @relation("SaleDepletionAllocationUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, effectId, sequence])
  @@index([tenantId, effectId])
  @@index([tenantId, physicalBatchId])
  @@index([tenantId, costBasisBatchId])
  @@map("sale_depletion_allocations")
  @@schema("inventory")
}
