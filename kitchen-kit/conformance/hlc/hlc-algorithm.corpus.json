    },
    {
      "id": "local-clock-went-backwards-increments-logical",
      "description": "pt < l. max keeps l, so l' == l and c' = c + 1. This is the case that makes HLC survive a device whose wall clock jumps backwards.",
      "state": "1722765753000.00007.0f1e2d3c4b5a69788796a5b4c3d2e1f0",
      "physicalMs": "1722765752000",
      "expected": "1722765753000.00008.0f1e2d3c4b5a69788796a5b4c3d2e1f0"
    },
    {
      "id": "local-equal-physical-increments-logical",
      "description": "pt == l, so l' == l and c' = c + 1. Two events in the same millisecond stay strictly ordered.",
      "state": "1722765753000.00000.0f1e2d3c4b5a69788796a5b4c3d2e1f0",
      "physicalMs": "1722765753000",
      "expected": "1722765753000.00001.0f1e2d3c4b5a69788796a5b4c3d2e1f0"
    },
    {
      "id": "local-logical-at-upper-bound",
      "description": "c = 99998 -> c' = 99999, the largest value the ratified 5-digit field can carry.",
      "state": "1722765753000.99998.0f1e2d3c4b5a69788796a5b4c3d2e1f0",
      "physicalMs": "1722765753000",
      "expected": "1722765753000.99999.0f1e2d3c4b5a69788796a5b4c3d2e1f0"
    },
    {
      "id": "local-logical-overflow-fails-closed",
      "description": "c = 99999 and pt <= l would need c' = 100000, which the ratified representation cannot carry. Truncating would silently corrupt causal order, so the implementation MUST fail rather than emit a wrong value.",
